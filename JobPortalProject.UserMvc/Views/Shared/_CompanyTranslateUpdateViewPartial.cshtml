@model CompanyTranslationEditPageViewModel

<input asp-for="LangaugeId" value="@Model.LangaugeId" type="hidden" />
<div class="section-title2">
    <h5>Company Details:</h5>
</div>
 <input asp-for="CompanyTranslationUpdateViewModel.TranslationId" value="@Model.CompanyTranslationUpdateViewModel.TranslationId" type="hidden"> 
<div class="col-md-6">
    <div class="form-inner mb-25">
        <label for="companyname">Company Name*</label>
        <div class="input-area">
            <img src="~/images/icon/company-2.svg" alt="">
              <input asp-for="CompanyTranslationUpdateViewModel.Name" id="companyname" placeholder="Elite Hangstroman" />
              <span asp-validation-for="CompanyTranslationUpdateViewModel.Name"></span>
        </div>
    </div>
</div>
<div class="col-md-12">
    <div class="form-inner mb-40">
        <label for="description">Description*</label>
            <textarea asp-for="CompanyTranslationUpdateViewModel.Description" placeholder="Company Details*"></textarea> 
            <span asp-validation-for="CompanyTranslationUpdateViewModel.Description"></span>
    </div>
</div>
    <div class="section-title2">
    <h5>Working Areas:</h5>
        <div class="dash"></div>
    </div>
  <div class="work-area-row">
            @for (int i = 0; i < Model.WorkingFieldUpdateViewModels.Count; i++)
    {
        <input asp-for="WorkingFieldUpdateViewModels[i].WorkingFieldId"
                            value="@Model.WorkingFieldUpdateViewModels[i].WorkingFieldId"
                            type="hidden" />
                    <div class="row" id="workingAreaItemRow${@Model.WorkingFieldUpdateViewModels[i].WorkingFieldId}">


            <input asp-for="WorkingFieldUpdateViewModels[i].WorkingFieldTranslationUpdateViewModel!.WorkingFieldTranslationId"
                   value="@Model.WorkingFieldUpdateViewModels[i].WorkingFieldTranslationUpdateViewModel!.WorkingFieldTranslationId"
                   type="hidden" />
                        <div class="col-md-6">
                            <div class="form-inner mb-25">
                                <label for="working-field">Working Field *</label>
                                <div class="input-area">
                                    <img src="~/images/icon/company-2.svg" alt="">
                                    <input asp-for="WorkingFieldUpdateViewModels[i].WorkingFieldTranslationUpdateViewModel.Name" id="working-field" placeholder="Frontend Developer" />
                                    <span asp-validation-for="WorkingFieldUpdateViewModels[i].WorkingFieldTranslationUpdateViewModel.Name"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-inner mb-25">
                                <label>Add Icon*</label>
                                <div class="input-area">
                                    <img src="~/images/icon/company-2.svg" alt="">
                                    <input asp-for="WorkingFieldUpdateViewModels[i].IconFile" accept="image/*">
                                    <span asp-validation-for="WorkingFieldUpdateViewModels[i].IconFile"></span>
                                    <div class="form-inner mb-25">
                                        <input name="@Model.WorkingFieldUpdateViewModels[i].IconUrl" value="@Model.WorkingFieldUpdateViewModels[i].IconUrl" type="hidden" />
                                        <img src="@Model.WorkingFieldUpdateViewModels[i].IconUrl" width="100" height="100" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-inner mb-40">
                                <label for="description">Short Description*</label>
                                <input asp-for="WorkingFieldUpdateViewModels[i].WorkingFieldTranslationUpdateViewModel.Description" id="description" placeholder="Details*" />
                                <span asp-validation-for="WorkingFieldUpdateViewModels[i].WorkingFieldTranslationUpdateViewModel.Description"></span>
                            </div>
                <div class="add-row">
                    <button onclick="deleteWorkingField(@Model.WorkingFieldUpdateViewModels[i].WorkingFieldId)"
                            type="button" class="remove-work-area-row remove">
                        Remove Work Area
                    </button>
                </div>
                <div class="section-title two">
                    <div class="dash"></div>
                </div>
                        </div>
                    </div>
                    <br />
                }
                </div>

<div class="section-title2">
    <h5>Locations:</h5>
</div>
                @for (int i = 0; i < Model.AddressUpdateViewModels.Count; i++)
                {
                    <div id="address${@Model.AddressUpdateViewModels[i].Id}">
                    <input asp-for="AddressUpdateViewModels[i].AddressTranslationId" value="@Model.AddressUpdateViewModels[i].AddressTranslationId" type="hidden" />
                    <input asp-for="AddressUpdateViewModels[i].Id" value="@Model.AddressUpdateViewModels[i].Id" type="hidden" />
                    
                    <div class="col-md-6">
                        <div class="form-inner mb-25">
              
                            <label for="location">City *</label>
                            <div class="input-area">
                                <img src="~/images/icon/map-2.svg" alt="">
                                <select asp-items="Model.AddressUpdateViewModels[i].CityListItems" asp-for="AddressUpdateViewModels[i].CityId" class="select1"></select>
                                <span asp-validation-for="AddressUpdateViewModels[i].CityId"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-inner mb-25">
                            <label for="location">Street *</label>
                            <div class="input-area">
                                <img src="~/images/icon/map-2.svg" alt="">
                                <input asp-for="AddressUpdateViewModels[i].Street" id="location" placeholder="Type Street">
                                <span asp-validation-for="AddressUpdateViewModels[i].Street"></span>
                            </div>
                        </div>
                    </div>
        <div class="add-row">
            <button onclick="deleteAddress(@Model.AddressUpdateViewModels[i].Id)"
                    type="button" class="remove-work-area-row remove">
                Remove Address
            </button>
        </div>
            <div class="section-title two">
                <div class="dash"></div>
            </div>
        
                    </div>
                }
            <div class="col-md-12">
        <div class="form-inner">
            <button class="primry-btn-2 lg-btn w-unset"  type="submit">Update Translation</button>
            <button class="primry-btn-2 lg-btn w-unset" onclick="cancelCompanyTranslationUpdate(5)" type="button">Cancel</button>
        </div>
    </div>
