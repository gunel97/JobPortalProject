@model EducationUpdatePageViewModel
<!-- ========== Dashboard Area end============= -->
<div class="dashboard-area pt-120 mb-120">
    <div class="container">
        <div class="row g-lg-4 gy-5 mb-90">
            <div class="col-lg-3">
                <div class="dashboard-sidebar">
                    <partial name="_CandidateSidebarPartial" model="@Model.DashboardModel" />
                </div>
            </div>
            <div class="col-lg-9">
                <div class="edit-profile-inner">
                    <div class="form-wrapper">
                        <ul class="nav nav-tabs" id="myTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <a asp-controller="candidate" asp-action="personalInfoUpdate" class="nav-link" id="home-tab" type="button"
                                        role="tab" aria-controls="home" aria-selected="false">
                                    <span></span>Basic Information:
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a asp-controller="candidate" asp-action="profileUpdate" class="nav-link" id="profile-tab" type="button"
                                   role="tab" aria-controls="profile" aria-selected="false">
                                    <span></span>Profile
                                </a>

                            </li>
                            <li class="nav-item" role="presentation">
                                <a asp-controller="candidate" asp-action="educationUpdate" class="nav-link active" id="contact-tab" type="button"
                                        role="tab" aria-controls="contact" aria-selected="false">
                                    <span></span>Education
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a asp-controller="candidate" asp-action="experienceUpdate" class="nav-link" id="professional-tab" type="button"
                                        role="tab" aria-controls="professional" aria-selected="false">
                                    <span></span>Professional Info
                                </a>
                            </li>
                        </ul>
                        <div class="tab-content" id="myTabContent">
                            <div class="tab-pane fade show active" id="contact" role="tabpanel" aria-labelledby="contact-tab">
                                <div id="resumeEducationRow" class="row">
                                    <partial name="_EducationUpdatePartial" model="@Model" />
                                </div>
                              
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Dashboard Area end============= -->

<!-- ========== Add education modal============= -->
<div class="modal fade" id="addEducation" tabindex="-1" aria-labelledby="addEducationLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
            </div>
            <div class="form-wrapper">
            <form method="post" asp-action="AddEducationToResume" asp-controller="Candidate" class="edit-profile-form profile-form">
                <div class="modal-body">
                    <div class="section-title2">
                        <h5>Educational Qualification:</h5>
                    </div>
                    <div class="education-row">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="info-title">
                                    <h6>Academic Information:</h6>
                                    <div class="dash"></div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                    <div class="form-inner mb-25">
                                        <label>Education Level*</label>
                                        <div class="input-area">
                                            <img src="~/images/icon/qualification-2.svg" alt="">
                                            <select name="EducationTypeId" asp-items="@Model.EducationTypes" class="select1">
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                @if (Model.DashboardModel.ReadyLanguages.Any())
                                {
                                @for (int i = 0; i < Model.DashboardModel?.ReadyLanguages.Count(); i++)
                                {
                                    <input name="Translations[@i].LanguageId" value="@Model.DashboardModel.ReadyLanguages[i].Id" type="hidden" />
                                    <div class="col-md-6">
                                        <div class="form-inner mb-25">
                                            <label>My Major* <img src="@Model.DashboardModel.ReadyLanguages[i].IconUrl"/></label>
                                            <div class="input-area">
                                                <img src="~/images/icon/major.svg" alt="">
                                                <input name="Translations[@i].MajorName" id="institute" placeholder="Type Your Major Name...">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-inner mb-25">
                                                <label for="institute">Institute/University* <img src="@Model.DashboardModel.ReadyLanguages[i].IconUrl" /></label>
                                            <div class="input-area">
                                                <img src="~/images/icon/univercity.svg" alt="">
                                                <input name="Translations[@i].SchoolName" id="institute" placeholder="Type Your Institute Name...">
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                                <div class="col-md-6">
                                    <div class="form-inner mb-20">
                                        <label for="datepicker10">Starting Period*</label>
                                        <div class="input-area">
                                            <img src="~/images/icon/calender2.svg" alt="">
                                            <input name="StartDate" id="datepicker10"  placeholder="DD/MM/YY">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-inner mb-20">
                                        <label for="datepicker11">Ending Period*</label>
                                        <div class="input-area">
                                            <img src="~/images/icon/calender2.svg" alt="">
                                            <input name="EndDate" id="datepicker11" placeholder="DD/MM/YY">
                                        </div>
                                    </div>
                                </div>
                            </div>
                    </div>
                </div>
                <div class="modal-footer">
                        <button type="button" class="primry-btn-2 lg-btn w-unset" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="primry-btn-2 lg-btn w-unset">Save</button>
                </div>
            </form>
       </div>
        </div>
    </div>
</div>
<!-- ========== Add education modal end============= -->

<script>
    function deleteEducation(id){
        console.log(id);
          var row = document.getElementById('resumeEducationRow');

    fetch(`/candidate/deleteEducation?id=${id}`, {
        method: 'POST'
    })
        .then(response => response.json())
        .then(data => {
            console.log(data);
            row.innerHTML="";
            row.innerHTML = data.educationHtml;
        })
        .catch(error => console.error('Error:', error));
    }
</script>

@if (TempData["CloseModal"] != null)
{
    <script>
        // Close the modal on page load
        document.addEventListener('DOMContentLoaded', function() {
            var modal = bootstrap.Modal.getInstance(document.getElementById('addEducation'));
            if (modal) {
                modal.hide();
            }

            // Optional: Show success message
            @if (TempData["Success"] != null)
            {
                            <text>
                            alert('@TempData["Success"]');
                            </text>
            }
        });






    </script>
}
