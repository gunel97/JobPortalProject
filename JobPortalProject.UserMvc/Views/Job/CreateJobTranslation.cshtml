@model AddTranslationToJobViewModel

<!-- ========== Inner Banner Start============= -->
<div class="inner-banner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="banner-content text-center">
                    <h1>Post A Jobs</h1>
                    <span></span>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a>Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Post A Jobs</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Inner Banner end============= -->
<!-- ========== Login Area end============= -->
<div class="job-post-area pt-120 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="form-wrapper">
                    <form method="post">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="section-title2">
                                    <h5>Job Details Translation <img src="@Model.TranslationCreateViewModel.LanguageIcon" alt=""> :</h5>
                                </div>
                            </div>
                            <input asp-for="JobId" value="@Model.JobId" type="hidden" />
                            <input asp-for="LanguageId" value="@Model.LanguageId" type="hidden" />
                            <input asp-for="TranslationCreateViewModel.LanguageId" value="@Model.LanguageId" type="hidden" />
                            <input asp-for="TranslationCreateViewModel.JobId" value="@Model.JobId" type="hidden" />
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label for="jobtitle">Job Title*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/company-2.svg" alt="">
                                        <input asp-for="TranslationCreateViewModel.Title" id="jobtitle" placeholder="Senior UI/UX Engineer">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label for="experiences">Experience Level*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/email-2.svg" alt="">
                                        <input asp-for="TranslationCreateViewModel.RequiredExperience" id="experiences" placeholder="Type Experiences">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-inner mb-25">
                                    <label for="jobtitle">Job Description*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/company-2.svg" alt="">
                                        <input asp-for="TranslationCreateViewModel.Description" id="description" placeholder="Senior UI/UX Engineer">
                                    </div>
                                </div>
                            </div>
                            @if (Model.ExtraBenefits.Any())
                            {
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="section-title2">
                                            <h5 id="benefitTitle">Job Benefits - <img src="@Model.LanguageIcon"/></h5>
                                        </div>
                                    </div>
                                    <div id="bContainer" class="col-md-12">
                                        @for (int i=0; i< Model.ExtraBenefits.Count; i++)
                                        {
                                            <div class="col-md-12">
                                                <div class="form-inner mb-25">
                                                    <label for="jobtitle">Benefit * - (@Model.ExtraBenefits[i].ReadyValue - <img src="@Model.ReadyLanguageIcon" />)</label>
                                                    <div class="input-area">
                                                        <img src="~/images/icon/company-2.svg" alt="">
                                                        <input asp-for="@Model.ExtraBenefits[i].Value" id="description" placeholder="Senior UI/UX Engineer">
                                                        <input asp-for="@Model.ExtraBenefits[i].JobExtraBenefitId" value="@Model.ExtraBenefits[i].JobExtraBenefitId" type="hidden" />
                                                        <input asp-for="@Model.ExtraBenefits[i].LanguageId" value="@Model.LanguageId" type="hidden" />
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="section-title2">
                                        <h5 id="responsibilityTitle"> Job Responsibilities - <img src="@Model.LanguageIcon"/></h5>
                                    </div>
                                </div>
                                <div id="rContainer" class="col-md-12">
                                    @for(int i=0; i<Model.Responsibilities.Count; i++){
                                        <div class="col-md-12">
                                            <div class="form-inner mb-25">
                                                <label for="jobtitle">Responsibility* - (@Model.Responsibilities[i].ReadyValue - <img src="@Model.ReadyLanguageIcon" />)</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/company-2.svg" alt="">
                                                    <input asp-for="@Model.Responsibilities[i].Value" id="description" placeholder="Senior UI/UX Engineer">
                                                    <input asp-for="@Model.Responsibilities[i].JobResponsibilityId" value="@Model.Responsibilities[i].JobResponsibilityId" type="hidden" />
                                                    <input asp-for="@Model.Responsibilities[i].LanguageId" value="@Model.LanguageId" type="hidden" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <br />
                            <div class="col-md-12">
                                <br />
                                <div class="form-inner">
                                    <button class="primry-btn-2 lg-btn w-unset" type="submit">Add</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Login Area end============= -->