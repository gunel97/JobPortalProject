 @{
    AppliedJobsOfCandidatePageViewModel model = Model;
    var applications = model.JobApplicationsModels;   
    var filter = Model.Filter ?? new JobApplicationsOfCandidateFilterViewModel();

    var currentSortBy = filter.SortBy?.ToLower() ?? "";
    var currentSortOrder = filter.SortOrder?.ToLower() ?? "desc";

    var nextSortOrder = (currentSortBy == "appliedat" && currentSortOrder == "desc") ? "asc" : "desc";

    string sortIconClass;
    if (currentSortBy == "appliedat")
        sortIconClass = currentSortOrder == "asc" ? "bi bi-arrow-up-short" : "bi bi-arrow-down-short";
    else
        sortIconClass = "bi bi-arrow-down-up"; 
}
 
<div class="dashboard-area pt-120 mb-120">
    <div class="container">
        <div class="row g-lg-4 gy-5 mb-90">
            <div class="col-lg-3">
                <partial name="_CandidateSidebarPartial" model="@Model.Dashboard"/>
            </div>
            <div class="col-lg-9">
                <div class="applied-job-area">
                    <div class="table-wrapper">
                        <div class="table-title-filter">
                            <div class="section-title">
                                <h5>Applied Jobs</h5>
                            </div>
                        </div>                             
                        <table class="eg-table table category-table mb-40">
                            <thead>
                                <tr>
                                    <th>Job Information</th>

                                    <th>
                                        <a asp-action="appliedJobs"
                                           asp-route-searchTerm="@filter.SearchTerm"
                                           asp-route-index="0"
                                           asp-route-size="@filter.Size"
                                           asp-route-sortBy="appliedat"
                                           asp-route-sortOrder="@nextSortOrder"
                                           style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 8px; cursor: pointer;">

                                            <span>Apply Date</span>
                                            <span class="d-flex align-items-center justify-content-center shadow-sm"
                                                  style="width: 24px; height: 24px; background: #fff; border-radius: 50%; color: #000000;">

                                                <i class="@sortIconClass" style="font-size: 16px; font-weight: bold;"></i>
                                            </span>
                                        </a>
                                    </th>

                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (applications.Items.Any())
                                {
                                    @foreach (var item in applications.Items)
                                    {
                                        <tr>
                                            <td data-label="Job Title">
                                                <div class="company-info">
                                                    <div class="logo">
                                                        <img src="@item.CompanyLogo" alt="">
                                                    </div>
                                                    <div class="company-details">
                                                        <div class="top">
                                                            <h6><a asp-controller="job" asp-action="details" asp-route-id="@item.JobDetailsUrl">@item.JobTitle</a></h6>
                                                            <span><img src="~/images/icon/calender2.svg" alt="">@item.JobCreatedAt.Date.ToShortDateString()</span>
                                                        </div>
                                                        <div class="top">
                                                            <a class="view-btn" asp-controller="company" asp-action="details" asp-route-id="@item.CompanyDetailsUrl">@item.CompanyName </a>
                                                        </div>
                                                        <ul>
                                                            <li><img src="~/images/icon/location.svg" alt="">@item.JobAddress</li>
                                                            <li>
                                                                <img src="~/images/icon/arrow2.svg" alt="">
                                                                <p><span class="title">Salary:</span> $@item.MinSalary-$@item.MaxSalary / <span class="time">@localizer.GetValue(item.SalaryType ?? "")</span></p>
                                                            </li>
                                                            
                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                            <td data-label="Apply Job">@item.AppliedAt.Date.ToShortDateString()</td>
                                            <td data-label="Status">
                                                @if(item.Status=="cancelled"){
                                                    <a class="eg-btn orenge-btn" id=@("jobStatus"+item.JobId)>@localizer.GetValue(item.Status ?? "")</a>
                                                }
                                                else
                                                {
                                                    <a class="eg-btn purple-btn" id=@("jobStatus" + item.JobId)>@localizer.GetValue(item.Status ?? "")</a>
                                                }
                                            </td>
                                            <td data-label="Status">
                                                @if(item.Status=="applied"){
                                                    <button onclick="cancelJobApplication(@item.JobId, this)" class="eg-btn orenge-btn">Cancel</button>
                                                }
                                            </td>
                                           
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        @{
                            var routeData = new Dictionary<string, string>
                                                {
                                                { "size", applications.Size.ToString() },
                                                { "SortBy", filter.SortBy ?? "" },
                                                { "SortOrder", filter.SortOrder ?? "" }
                                                };

                            ViewData["RouteData"] = routeData;
                        }
                        <div class="pagination-table-info">
                            <div class="table-info">
                                @{
                                    var startRecord = (applications.Index * applications.Size) + 1;
                                    var endRecord = startRecord + applications.Items.Count() - 1;
                                    if (applications.Count == 0) { startRecord = 0; endRecord = 0; }
                                }
                                <span>@startRecord - @endRecord Results Showing In @applications.Count Jobs</span>
                            </div>
                            <partial name="_PaginationPartial" model="@applications" />            
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
<script>
    function cancelJobApplication(id, element) {
            if (!confirm("Are you sure you want to cancel this application?")) {
                    return;
                }
        console.log("cancel");
        console.log(id);
        const jobStatus = document.getElementById(`jobStatus${id}`);
        fetch(`/jobApplication/cancel/${id}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application-json'
            }
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Cancelled');
                    element.remove();
                    jobStatus.innerHTML = "Cancelled";
                        jobStatus.classList.remove('purple-btn'); // Optional: change color
                            jobStatus.classList.add('orenge-btn');
                    return;
                }
                else {
                    alert(data.message);
                }
            })
            .catch(error => console.error('Error:', error));
    };

</script>
}