@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm border-success">
        <div class="card-body p-5">
            <div class="mb-4 text-success">
                <i class="bi bi-check-circle-fill" style="font-size: 5rem;"></i>
            </div>

            <h1 class="text-success mb-3">Payment Successful!</h1>
            <p class="lead text-muted">
                Thank you! Your membership has been activated for 30 days.
            </p>

            <hr class="my-4" />

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Company" asp-action="Dashboard" class="btn btn-outline-secondary">
                    Go To Dashboard
                </a>
                <a asp-controller="Job" asp-action="Create" class="btn btn-success btn-lg">
                    <i class="bi bi-pencil-square"></i> Post a Job Now
                </a>
            </div>
        </div>
    </div>
</div>