@model OrderPagedIndexViewModel
@{
    string GetSortOrder(string columnName)
    {
        if (Model.Filter?.SortBy == columnName)
        {
            return Model.Filter.SortOrder == "asc" ? "desc" : "asc";
        }
        return "desc"; 
    }
}
<div id="main-content" class="h-full w-full bg-gray-50 relative overflow-y-auto lg:ml-64">
    <main>
        <form class="sm:pr-3 mb-4 sm:mb-0" asp-action="Index" method="GET">
            <div class="p-4 bg-white block sm:flex items-center justify-between border-b border-gray-200 lg:mt-1.5">
                <div class="mb-1 w-full">
                    <div class="block sm:flex items-center md:divide-x md:divide-gray-100 gap-4">

                        <div class="mt-1 relative sm:w-48">
                            <select asp-for="Filter.Status"
                                    asp-items="Model.PaymentStatuses"
                                    onchange="this.form.submit()"
                                    class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5">

                                <option value="">All Statuses</option>

                            </select>
                        </div>
                        @if (Model.Filter?.Status != null)
                        {
                            <div class="mt-1 ml-4">
                                <a asp-action="Index" class="text-gray-900 bg-white border border-gray-300 hover:bg-gray-100 font-medium rounded-lg text-sm px-3 py-2.5">
                                    Clear
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="flex flex-col">
                <div class="overflow-x-auto">
                    <div class="align-middle inline-block min-w-full">
                        <div class="shadow overflow-hidden">
                            <table class="table-fixed min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-100">
                                    <tr>
                                        <th scope="col" class="p-4"><input type="checkbox" class="..."></th>

                                        <th scope="col" class="p-4 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer hover:bg-gray-200">
                                            <a asp-action="Index"
                                               asp-route-SortBy="CompanyName"
                                               asp-route-SortOrder="@GetSortOrder("CompanyName")"
                                               asp-route-Status="@Model.Filter?.Status"
                                               class="flex items-center">
                                                Company Name
                                                @if (Model.Filter?.SortBy == "CompanyName")
                                                {
                                                    <span class="ml-1">@(Model.Filter.SortOrder == "asc" ? "↑" : "↓")</span>
                                                }
                                            </a>
                                        </th>

                                        <th scope="col" class="p-4 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer hover:bg-gray-200">
                                            <a asp-action="Index"
                                               asp-route-SortBy="CreatedAt"
                                               asp-route-SortOrder="@GetSortOrder("CreatedAt")"
                                               asp-route-Status="@Model.Filter?.Status"
                                               class="flex items-center">
                                                Created At
                                                @if (Model.Filter?.SortBy == "CreatedAt")
                                                {
                                                    <span class="ml-1">@(Model.Filter.SortOrder == "asc" ? "↑" : "↓")</span>
                                                }
                                            </a>
                                        </th>

                                        <th scope="col" class="p-4 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer hover:bg-gray-200">
                                            <a asp-action="Index"
                                               asp-route-SortBy="Amount"
                                               asp-route-SortOrder="@GetSortOrder("Amount")"
                                               asp-route-Status="@Model.Filter?.Status"
                                               class="flex items-center">
                                                Amount
                                                @if (Model.Filter?.SortBy == "Amount")
                                                {
                                                    <span class="ml-1">@(Model.Filter.SortOrder == "asc" ? "↑" : "↓")</span>
                                                }
                                            </a>
                                        </th>

                                        <th scope="col" class="p-4 text-left text-xs font-medium text-gray-500 uppercase">
                                            Status
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">

                                    @if (Model.Orders.Items.Any())

                                    {

                                        @foreach (var order in Model.Orders.Items ?? [])

                                        {

                                            <tr class="hover:bg-gray-100">

                                                <td class="p-4 w-4">

                                                    <div class="flex items-center">

                                                        <input id="checkbox-@order.Id" type="checkbox" class="bg-gray-50 border-gray-300 focus:ring-3 focus:ring-cyan-200 h-4 w-4 rounded">
                                                    </div>
                                                </td>
                                                <td class="p-4 whitespace-nowrap text-sm font-normal text-gray-500">
                                                    <div class="text-base font-semibold text-gray-900">@order.CompanyName</div>
                                                </td>
                                                <td class="p-4 whitespace-nowrap text-sm font-normal text-gray-500">
                                                    @order.CreatedAt.ToString("dd MMM yyyy")
                                                </td>
                                                <td class="p-4 whitespace-nowrap text-sm font-normal text-gray-500">
                                                    @order.Amount
                                                </td>
                                                <td class="p-4 whitespace-nowrap text-sm font-normal text-gray-500">
                                                    @localizer.GetValue(order.Status.ToString() ?? "")
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="p-4 text-center text-gray-500">
                                                No payments found matching your search criteria.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            @{
                var routeData = new Dictionary<string, string>
                        {
                        { "Size", Model.Orders.Size.ToString() },
                        { "SortBy", Model.Filter?.SortBy ?? "" },
                        { "SortOrder", Model.Filter?.SortOrder ?? "" },
                        { "Status", Model.Filter?.Status?.ToString() ?? "" } 
                        };
                ViewData["RouteData"] = routeData;
            }

            <partial name="_PaginationPartial" model="@Model.Orders" />

            <input type="hidden" name="SortBy" value="@Model.Filter?.SortBy" />
            <input type="hidden" name="SortOrder" value="@Model.Filter?.SortOrder" />
        </form>
    </main>

