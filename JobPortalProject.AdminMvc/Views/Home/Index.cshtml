@model IndexViewModel
<div id="main-content" class="h-full w-full bg-gray-50 relative overflow-y-auto lg:ml-64">
    <main>

        <div class="pt-6 px-4">
            <div class="w-full grid grid-cols-1 xl:grid-cols-2 2xl:grid-cols-3 gap-4">

                <div class="bg-white shadow rounded-lg p-4 sm:p-6 xl:p-8 ">

                    <!-- Card Title -->
                    <div class="mb-4 flex items-center justify-between">
                        <div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">Latest Transactions</h3>
                            <span class="text-base font-normal text-gray-500">This is a list of latest transactions</span>
                        </div>
                        <div class="flex-shrink-0">
                            <a asp-controller="order" asp-action="index" class="text-sm font-medium text-cyan-600 hover:bg-gray-100 rounded-lg p-2">View all</a>
                        </div>
                    </div>
                    <!-- Table -->
                    <div class="flex flex-col mt-8">
                        <div class="overflow-x-auto rounded-lg">
                            <div class="align-middle inline-block min-w-full">
                                <div class="shadow overflow-hidden sm:rounded-lg">
                                    <table class="min-w-full divide-y divide-gray-200">
                                        <thead class="bg-gray-50">
                                            <tr>
                                                <th scope="col" class="p-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Payment
                                                </th>
                                                <th scope="col" class="p-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                    Date 
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody class="bg-white">
                                            @if (Model.Orders.Any()) {
                                                @foreach (var item in Model.Orders)
                                                {
                                                    <tr>
                                                        <td class="p-4 whitespace-nowrap text-sm font-normal text-gray-900">
                                                            Payment from <span class="font-semibold">@item.CompanyName</span>
                                                        </td>
                                                        <td class="p-4 whitespace-nowrap text-sm font-normal text-gray-500">
                                                            @item.CreatedAt.Date.ToShortDateString()
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <div class="grid grid-cols-1 2xl:grid-cols-2 xl:gap-4 my-4">

            </div>
        </div>
    </main>
