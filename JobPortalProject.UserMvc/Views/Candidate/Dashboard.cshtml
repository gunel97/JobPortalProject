@model CandidateDashboardViewModel
    <!-- ========== Dashboard Area end============= -->
<div class="dashboard-area pt-120 mb-120">
    <div class="container">
        <div class="row g-lg-4 gy-5 mb-90">
            <div class="col-lg-3">
          <partial name="_CandidateSidebarPartial" model="Model"/>
            </div>
            <div class="col-lg-9">
                <div class="dashboard-inner">
                    <div class="author-area">
                        <div class="author-img">
                            <img src="@Model.ImageUrl" alt="">
                        </div>
                        <div class="author-content">
                            <span>Hello, @Model.UserName</span>
                        </div>
                    </div>
                    
                    @if(Model.Applications.Any()){
                    <div class="table-wrapper">
                        <h5 class="title">Latest Applied Jobs:</h5>
                        <div class="scroll-table">
                            <table class="eg-table table category-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Job Tittle</th>
                                        <th>Apply Date</th>
                                        <th>Company</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Applications ?? [])
                                    {
                                        <tr>
                                            <td data-label="Job Title">
                                                <div class="company-info">
                                                    <div class="logo">
                                                        <img src="@item.CompanyLogo" alt="">
                                                    </div>
                                                    <div class="company-details">
                                                        <div class="top">
                                                            <h6><a asp-controller="job" asp-action="details" asp-route-id="@item.JobDetailsUrl">@item.JobTitle</a></h6>
                                                            <span><img src="~/images/icon/calender2.svg" alt="">@item.JobCreatedAt.Date.ToShortDateString()</span>
                                                        </div>
                                                        <ul>
                                                            <li><img src="~/images/icon/location.svg" alt="">@item.JobAddress</li>
                                                            <li>
                                                                <img src="~/images/icon/arrow2.svg" alt="">
                                                                <p><span class="title">Salary:</span> $@item.MinSalary-$@item.MaxSalary / <span class="time">@localizer.GetValue(item.SalaryType ?? "")</span></p>
                                                            </li>

                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                            <td data-label="Apply Job">@item.AppliedAt.Date.ToShortDateString()</td>
                                            <td data-label="Company">  
                                                <a class="view-btn" asp-controller="company" asp-action="details" asp-route-id="@item.CompanyDetailsUrl">@item.CompanyName </a>
                                                </td>
                                            <td data-label="Status"><button class="eg-btn purple-btn">@localizer.GetValue(item.Status ?? "")</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                    }
             
                </div>

            </div>
        </div>
    </div>
</div>
<!-- ========== Dashboard Area end============= -->