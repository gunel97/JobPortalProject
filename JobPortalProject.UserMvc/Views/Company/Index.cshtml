@{
    PagedCompanyListingViewModel model = Model;
    var filter = model.Filter;
    var companyTypes = model.CompanyTypes;
    var companies = model.Companies;
    var addressesCitiesGroup = model.AddressesCitiesGroup;
}
<!-- ========== Inner Banner Start============= -->
<div class="inner-banner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="banner-content text-center">
                    <h1>Company Listing</h1>
                    <span></span>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-asp-controller="home" asp-action="index">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Company Listing</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Inner Banner end============= -->
<!-- ========== Company Listing Start============= -->
<div class="company-listing-area pt-120 mb-120">
    <div class="container">
        <form asp-action="Index" method="get" id="filterForm">
        <div class="row g-lg-4 gy-5">
            <div class="col-lg-4 order-lg-1 order-2">
                <div class="job-sidebar">
                        <div class="job-widget mb-20">
                            <div class="check-box-item">
                                <h5 class="job-widget-title">Search</h5>
                                <div class="form-inner">
                                    <input type="text"
                                           name="SearchTerm"
                                           value="@filter.SearchTerm"
                                           placeholder="Search job..."
                                           class="form-control">
                                </div>
                            </div>
                        </div>
                    <div class="job-widget style-1 mb-20">
                        <div class="check-box-item">
                            <h5 class="job-widget-title">Company Category</h5>
                            <div class="checkbox-container">
                                <ul>
                                    @foreach (var type in companyTypes ?? [])
                                    {
                                        @if(type.CompanyIds.Count()!=0){
                                        <li>
                                            <label class="containerss">
                                                <input type="checkbox"
                                                        name="TypeIds"
                                                        value="@type.Id"
                                                        @(filter.TypeIds.Contains(type.Id) ? "checked" : "")
                                                        onchange="document.getElementById('Index').value=0; document.getElementById('filterForm').submit();">
                                                <span class="checkmark"></span>
                                                <span class="text">@type?.Name</span>
                                                <span class="qty">(@type?.CompanyIds.Count())</span>
                                            </label>
                                        </li>
                                        }
                                    }
                                </ul>

                            </div>
                        </div>
                    </div>
                    <div class="job-widget mb-20">
                        <div class="check-box-item">
                            <h5 class="job-widget-title">Country/ Location</h5>
                            <div class="checkbox-container">
                                <ul>
                                     @foreach (var group in addressesCitiesGroup ?? [])
                                    {
                                        @if(group.Count()!=0){
                                        var city = group.FirstOrDefault();
                                        <li>
                                            <label class="containerss">
                                            <input type="checkbox"
                                                    name="CityIds"
                                                    value="@city.City.Id"
                                                    @(filter.CityIds.Contains(city.City.Id) ? "checked" : "")
                                                    onchange="document.getElementById('Index').value=0; document.getElementById('filterForm').submit();">
                                                        <span class="checkmark"></span>
                                                <span class="text">@group.FirstOrDefault()?.CityName, @group.FirstOrDefault()?.CountryName</span>
                                                <span class="qty">(@group.Count())</span>
                                            </label>
                                        </li>
                                        }
                                    } 
                                </ul>

                            </div>
                        </div>
                    </div>
                    <div class="job-widget-btn">
                        <a class="primry-btn-2 lg-btn text-center" asp-action="Index">Clear Filters</a>
                    </div> 
                </div>
            </div>
            <div class="col-lg-8 order-lg-2 order-1">
                <div class="company-listing-wrap">
                    <div class="row g-4 mb-25">
                        <div class="col-lg-6 d-flex align-items-center">                            
                                @if (companies.Count == 0)
                                {
                                    <p class="show-item">No companies found.</p>
                                }
                                @if (companies.Count > 0)
                            {
                                <p class="show-item">Showing results @((companies.Index * companies.Size) + 1) - @Math.Min((companies.Index + 1) * companies.Size, companies.Count) from @companies.Count companies</p>
                            }
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-lg-end">
                            <div class="grid-select-area">
                                <div class="select-area">
                                    <select class="select1" name="SortBy" onchange="document.getElementById('Index').value = 0; document.getElementById('filterForm').submit();">
                                        <option value="title_asc"
                                                selected="@(filter.SortBy == "title_asc")">Name (A-Z)</option>
                                        <option value="title_desc"
                                                selected="@(filter.SortBy == "title_desc" || string.IsNullOrEmpty(filter.SortBy))">Name (Z-A)</option>
                                        <option value="lastpostedjob_desc"
                                                selected="@(filter.SortBy == "lastpostedjob_desc")">Last Posted Job (Newest First)</option>
                                        <option value="lastpostedjob_asc"
                                                selected="@(filter.SortBy == "lastpostedjob_asc")">Last Posted Job (Oldest First)</option>
                                    </select>
                                </div>
                                <div class="grid-area">
                                    <ul>
                                        <li>
                                            <a class="active" href="company-listing1.html">
                                                <svg width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M6.26106 6.95674H0.695674C0.311464 6.95674 0 6.64527 0 6.26106V0.695674C0 0.311464 0.311464 0 0.695674 0H6.26106C6.64527 0 6.95674 0.311464 6.95674 0.695674V6.26106C6.95674 6.64527 6.64527 6.95674 6.26106 6.95674Z" />
                                                    <path d="M15.304 6.95674H9.73864C9.35443 6.95674 9.04297 6.64527 9.04297 6.26106V0.695674C9.04297 0.311464 9.35443 0 9.73864 0H15.304C15.6882 0 15.9997 0.311464 15.9997 0.695674V6.26106C15.9997 6.64527 15.6882 6.95674 15.304 6.95674Z" />
                                                    <path d="M6.26106 16.0004H0.695674C0.311464 16.0004 0 15.689 0 15.3048V9.73937C0 9.35517 0.311464 9.0437 0.695674 9.0437H6.26106C6.64527 9.0437 6.95674 9.35517 6.95674 9.73937V15.3048C6.95674 15.689 6.64527 16.0004 6.26106 16.0004Z" />
                                                    <path d="M15.304 16.0004H9.73864C9.35443 16.0004 9.04297 15.689 9.04297 15.3048V9.73937C9.04297 9.35517 9.35443 9.0437 9.73864 9.0437H15.304C15.6882 9.0437 15.9997 9.35517 15.9997 9.73937V15.3048C15.9997 15.689 15.6882 16.0004 15.304 16.0004Z" />
                                                </svg>
                                            </a>
                                        </li>
                                        <li>
                                            <a href="company-listing2.html">
                                                <svg width="22" height="16" viewBox="0 0 22 16" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M1.91313 0C0.856731 0 0 0.893707 0 1.99656C0 3.09861 0.856731 3.99157 1.91313 3.99157C2.96953 3.99157 3.82626 3.09861 3.82626 1.99656C3.82626 0.893707 2.96953 0 1.91313 0Z" />
                                                    <path d="M1.91313 6.00464C0.856731 6.00464 0 6.8976 0 8.00045C0 9.1025 0.856731 9.99621 1.91313 9.99621C2.96953 9.99621 3.82626 9.1025 3.82626 8.00045C3.82626 6.8976 2.96953 6.00464 1.91313 6.00464Z" />
                                                    <path d="M1.91313 12.0085C0.856731 12.0085 0 12.9023 0 14.0043C0 15.1064 0.856731 16.0001 1.91313 16.0001C2.96953 16.0001 3.82626 15.1064 3.82626 14.0043C3.82626 12.9023 2.96953 12.0085 1.91313 12.0085Z" />
                                                    <path d="M20.561 0.495117H6.95229C6.15787 0.495117 5.51367 1.16716 5.51367 1.99665C5.51367 2.82545 6.15782 3.49744 6.95229 3.49744H20.561C21.3554 3.49744 21.9996 2.82545 21.9996 1.99665C21.9996 1.16716 21.3554 0.495117 20.561 0.495117Z" />
                                                    <path d="M20.561 6.49878H6.95229C6.15787 6.49878 5.51367 7.17077 5.51367 8.00032C5.51367 8.82911 6.15782 9.5011 6.95229 9.5011H20.561C21.3554 9.5011 21.9996 8.82911 21.9996 8.00032C21.9996 7.17077 21.3554 6.49878 20.561 6.49878Z" />
                                                    <path d="M20.561 12.5034H6.95229C6.15787 12.5034 5.51367 13.1754 5.51367 14.0042C5.51367 14.833 6.15782 15.5049 6.95229 15.5049H20.561C21.3554 15.5049 21.9996 14.833 21.9996 14.0042C21.9996 13.1754 21.3554 12.5034 20.561 12.5034Z" />
                                                </svg>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-4 mb-70">
                        @if(companies.Items.Any())
                        {
                            @foreach (var company in companies.Items)
                        {
                            <div class="col-md-6">
                                <div class="company-list-card1">
                                    <div class="company-area">
                                        <div class="logo">
                                            @if (company?.LogoUrl == null)
                                            {
                                                <img src="https://ui-avatars.com/api/?name=@company?.Name&background=random" alt="@company?.Name avatar" />
                                            }
                                            @if (company?.LogoUrl != null)
                                            {
                                                <img src="@company?.LogoUrl" alt="@company?.Name">
                                            }
                                        </div>
                                        <div class="company-content">
                                            <div class="company-details">
                                                <div class="name-location">
                                                    <h5><a asp-controller="company" asp-action="details" asp-route-id="@company?.DetailsUrl">@company?.Name</a></h5>
                                                    <p><img src="~/images/icon/location.svg" alt=""> @company?.MainAddress?.City?.Name, @company?.MainAddress?.City?.Country?.Name</p>
                                                    <p><img src="~/images/icon/person-2.svg" alt=""> @company?.Addresses.Count() locations</p>
                                                </div>
                                                <div class="bookmark">
                                                    <i class="bi bi-bookmark-fill"></i>
                                                </div>
                                            </div>
                                            <div class="job-details-vacancies">
                                                <div class="vacancies">
                                                    <p>Active Jobs: <span>@company?.ActiveJobCount</span></p>
                                                </div>
                                                <div class="apply-btn">
                                                    <a asp-controller="company" asp-action="details" asp-route-id="@company?.DetailsUrl"><span><img src="~/images/icon/apply-ellipse.svg" alt=""></span>View Details</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        }
                    </div>
                    <div class="row">
                        <div class="col-lg-12 d-flex justify-content-center">
                            @{
                                var routeData = new Dictionary<string, string>
                                                                {
                                                                { "size", companies.Size.ToString() },
                                                                { "SearchTerm", filter.SearchTerm ?? "" },
                                                                { "SortBy", filter.SortBy ?? "" },
                                                                { "SortOrder", filter.SortOrder ?? "" }
                                                                };

                                // Add TypeIds
                                for (int i = 0; i < filter.TypeIds.Count; i++)
                                {
                                    routeData[$"TypeIds[{i}]"] = filter.TypeIds[i].ToString();
                                }

                                // Add CityIds
                                for (int i = 0; i < filter.CityIds.Count; i++)
                                {
                                    routeData[$"CityIds[{i}]"] = filter.CityIds[i].ToString();
                                }

                                ViewData["RouteData"] = routeData;
                            }
                            <partial name="_PaginationPartial" model="@companies" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
                <input type="hidden" name="Index" id="Index" value="@filter.Index" />
                <input type="hidden" name="Size" value="@filter.Size" />
                <input type="hidden" name="SortOrder" value="@filter.SortOrder" />
        </form>
    </div>
</div>
<!-- ========== Company Listing e nd============= -->