@model JobViewModel
<div class="col-lg-12 mb-30">
    <div class="job-listing-card">
        <div class="job-top">
            <div class="job-list-content">
                <div class="company-area">
                    <div class="logo">
                        @if (Model.CompanyLogoUrl == null)
                        {
                            <img src="https://ui-avatars.com/api/?name=@Model.CompanyName&background=random" alt="@Model.CompanyName avatar" />
                        }
                        @if (Model.CompanyLogoUrl != null)
                        {
                            <img src="@Model.CompanyLogoUrl" alt="@Model.CompanyName">
                        }
                    </div>
                    <div class="company-details">
                        <div class="name-location">
                            <h5><a asp-controller="job" asp-action="details" asp-route-id="@Model.DetailsUrl">@Model.Title</a></h5>
                            <p><a asp-controller="company" asp-action="details" asp-route-id="@Model.CompanyDetailsUrl">@Model.CompanyName</a></p>
                        </div>
                    </div>
                </div>
                <div class="job-discription">
                    <ul>
                        <li>
                            <p><span class="title">Salary:</span>  $@Model.MinSalary -$@Model.MaxSalary / <span class="time">@localizer.GetValue(Model.SalaryTypeDuration ?? "")</span></p>
                        </li>
                        <li>
                            <p><span class="title">Posted: @Model.CreatedAt?.Date.ToShortDateString()</span> </p>
                        </li>
                        <li>
                            <p><span class="title">Deadline: @Model.ExpirationDate?.Date.ToShortDateString()</span> </p>
                        </li>
                        <li>
                            <p><span class="title">Address: @Model.Address?.CityName , @Model.Address?.CountryName </span> </p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="job-type-apply">
            <div class="job-type">
                <span class="light-green">@localizer.GetValue(Model.JobType ?? "")</span>
                <span class="light-green">@localizer.GetValue(Model.Gender ?? "")</span>
            </div>
            <div class="apply-btn">
                   @if (User.Identity!.IsAuthenticated && User.IsInRole("Candidate"))
                {
                    @if (Model.IsApplied)
                    {
                        <a asp-controller="candidate" asp-action="appliedJobs"><span><img src="~/images/icon/apply-ellipse.svg" alt=""></span>Applied</a>
                    }
                    else
                    {
                        <a onclick="applyJob(@Model.Id, this)"><span><img src="~/images/icon/apply-ellipse.svg" alt=""></span>Apply Now</a>
                    }
                }
            </div>
        </div>
    </div>
</div>