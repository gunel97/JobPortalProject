@model CompanyTranslationEditPageViewModel
@{
    ViewData["languageId"] = Model.LangaugeId;
}

<input asp-for="LangaugeId" value="@Model.LangaugeId" type="hidden" />
<div class="section-title2">
    <h5>Company Details:</h5>
</div>
 <input asp-for="CompanyTranslationUpdateViewModel.TranslationId" value="@Model.CompanyTranslationUpdateViewModel.TranslationId" type="hidden"> 
<div class="col-md-6">
    <div class="form-inner mb-25">
        <label for="companyname">Company Name*</label>
        <div class="input-area">
            <img src="~/images/icon/company-2.svg" alt="">
              <input asp-for="CompanyTranslationUpdateViewModel.Name" id="companyname" placeholder="Elite Hangstroman" />
              <span asp-validation-for="CompanyTranslationUpdateViewModel.Name"></span>
        </div>
    </div>
</div>
<div class="col-md-12">
    <div class="form-inner mb-40">
        <label for="description">Description*</label>
            <textarea asp-for="CompanyTranslationUpdateViewModel.Description" placeholder="Company Details*"></textarea> 
            <span asp-validation-for="CompanyTranslationUpdateViewModel.Description"></span>
    </div>
</div>
@if (Model.WorkingFieldUpdateViewModels.Any())
{
    <div id="workingFieldRow" class="row">
    <partial name="_WorkingFieldsUpdatePartial" model="@Model" />
    </div>
}

<div class="section-title2">
    <h5>Locations:</h5>
</div>
                @for (int i = 0; i < Model.AddressUpdateViewModels.Count; i++)
                {
    @if (Model.AddressUpdateViewModels[i].IsMainAddress)
    {
        <div class="section-title2">
            <h5>Main Address:</h5>
        </div>
    }
    <div id="address${@Model.AddressUpdateViewModels[i].Id}">
                    <input asp-for="AddressUpdateViewModels[i].AddressTranslationId" value="@Model.AddressUpdateViewModels[i].AddressTranslationId" type="hidden" />
                    <input asp-for="AddressUpdateViewModels[i].Id" value="@Model.AddressUpdateViewModels[i].Id" type="hidden" />                    
                    <div class="col-md-6">
                        <div class="form-inner mb-25">
              
                            <label for="location">City *</label>
                            <div class="input-area">
                                <img src="~/images/icon/map-2.svg" alt="">
                                <select asp-items="Model.AddressUpdateViewModels[i].CityListItems" asp-for="AddressUpdateViewModels[i].CityId" class="select1"></select>
                                <span asp-validation-for="AddressUpdateViewModels[i].CityId"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-inner mb-25">
                            <label for="location">Street *</label>
                            <div class="input-area">
                                <img src="~/images/icon/map-2.svg" alt="">
                                <input asp-for="AddressUpdateViewModels[i].Street" id="location" placeholder="Type Street">
                                <span asp-validation-for="AddressUpdateViewModels[i].Street"></span>
                            </div>
                        </div>
                    </div>
        <div class="add-row">
            <button onclick="deleteAddress(@Model.AddressUpdateViewModels[i].Id)"
                    type="button" class="remove-work-area-row remove">
                Remove Address
            </button>
        </div>
            <div class="section-title two">
                <div class="dash"></div>
            </div>
        
                    </div>
                }
            <div class="col-md-12">
        <div class="form-inner">
            <button class="primry-btn-2 lg-btn w-unset"  type="submit">Update Translation</button>
            <button class="primry-btn-2 lg-btn w-unset" onclick="cancelCompanyTranslationUpdate(5)" type="button">Cancel</button>
        </div>
    </div>
