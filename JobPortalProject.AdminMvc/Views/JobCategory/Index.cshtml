@model JobCategoryPagedIndexViewModel

  <div id="main-content" class="h-full w-full bg-gray-50 relative overflow-y-auto lg:ml-64">
    <main>
        <form class="sm:pr-3 mb-4 sm:mb-0" asp-action="Index" method="GET">
    <div class="p-4 bg-white block sm:flex items-center justify-between border-b border-gray-200 lg:mt-1.5">
        <div class="mb-1 w-full">
            <div class="mb-4">
                <nav class="flex mb-5" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-2">
                        <li class="inline-flex items-center">
                        <a href="#" class="text-gray-700 hover:text-gray-900 inline-flex items-center">
                            <svg class="w-5 h-5 mr-2.5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
                            Home
                        </a>
                        </li>
                        <li>
                        <div class="flex items-center">
                            <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                            <span class="text-gray-400 ml-1 md:ml-2 text-sm font-medium" aria-current="page">Job Categories</span>
                        </div>
                        </li>
                    </ol>
                </nav>
                <h1 class="text-xl sm:text-2xl font-semibold text-gray-900">All categories</h1>
            </div>

            <div class="block sm:flex items-center md:divide-x md:divide-gray-100">
                   
                    <label for="products-search" class="sr-only">Search</label>
                    <div class="mt-1 relative sm:w-64 xl:w-96">
                            <input type="text"
                                name="SearchTerm" 
                                value="@Model.Filter?.SearchTerm" 
                                id="products-search" 
                                class="bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5" placeholder="Search for products">
                    </div>
                <div class="flex items-center sm:justify-end w-full">
                    <div class="hidden md:flex pl-2 space-x-1">
                        <a class="text-gray-500 hover:text-gray-900 cursor-pointer p-1 hover:bg-gray-100 rounded inline-flex justify-center">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
                        </a>
                    </div>
                    <button type="button" data-modal-toggle="add-jobCategory-modal" class="text-white bg-cyan-600 hover:bg-cyan-700 focus:ring-4 focus:ring-cyan-200 font-medium inline-flex items-center rounded-lg text-sm px-3 py-2 text-center sm:ml-auto">
                        <svg class="-ml-1 mr-2 h-6 w-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path></svg>
                        Add job category
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="flex flex-col">
        <div class="overflow-x-auto">
            <div class="align-middle inline-block min-w-full">
                <div class="shadow overflow-hidden">
                    <table class="table-fixed min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-100">
                            <tr>
                                <th scope="col" class="p-4">
                                    <div class="flex items-center">
                                        <input id="checkbox-all" type="checkbox" class="bg-gray-50 border-gray-300 focus:ring-3 focus:ring-cyan-200 h-4 w-4 rounded">
                                    </div>
                                </th>
                                <th scope="col" class="p-4 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer hover:bg-gray-200 transition-colors">
                                    @{
                                        var nameSortOrder = (Model.Filter.SortBy?.ToLower() == "name" && Model.Filter.SortOrder?.ToLower() == "asc") ? "desc" : "asc";
                                    }
                                    <a asp-action="Index"
                                        asp-route-SortBy="name"
                                        asp-route-SortOrder="@nameSortOrder"
                                        asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                        asp-route-Size="@Model.Filter.Size"
                                        class="flex items-center">
                                        Company Type
                                        @if (Model.Filter.SortBy?.ToLower() == "name")
                                        {
                                            @if (Model.Filter.SortOrder?.ToLower() == "desc")
                                            {
                                                <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd"></path></svg>
                                            }
                                            else
                                            {
                                                <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                                            }
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4 ml-1 text-gray-400 opacity-50" fill="currentColor" viewBox="0 0 20 20"><path d="M5 10a1 1 0 011-1h8a1 1 0 110 2H6a1 1 0 01-1-1z"></path></svg>
                                        }
                                    </a>
                                </th>

                                <th scope="col" class="p-4 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer hover:bg-gray-200 transition-colors">
                                    @{
                                        var dateSortOrder = (Model.Filter.SortBy?.ToLower() == "createdat" && Model.Filter.SortOrder?.ToLower() == "asc") ? "desc" : "asc";
                                    }
                                    <a asp-action="Index"
                                        asp-route-SortBy="createdat"
                                        asp-route-SortOrder="@dateSortOrder"
                                        asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                        asp-route-Size="@Model.Filter.Size"
                                        class="flex items-center">
                                        Date Created
                                        @if (Model.Filter.SortBy?.ToLower() == "createdat")
                                        {
                                            @if (Model.Filter.SortOrder?.ToLower() == "desc")
                                            {
                                                <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd"></path></svg>
                                            }
                                            else
                                            {
                                                <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                                            }
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4 ml-1 text-gray-400 opacity-50" fill="currentColor" viewBox="0 0 20 20"><path d="M5 10a1 1 0 011-1h8a1 1 0 110 2H6a1 1 0 01-1-1z"></path></svg>
                                        }
                                    </a>
                                </th>
                                        <th scope="col" class="p-4 text-left text-xs font-medium text-gray-500 uppercase cursor-pointer hover:bg-gray-200 transition-colors">
                                            @{
                                                var jobCountSortOrder = (Model.Filter.SortBy?.ToLower() == "jobcount" && Model.Filter.SortOrder?.ToLower() == "asc") ? "desc" : "asc";
                                            }
                                            <a asp-action="Index"
                                               asp-route-SortBy="jobcount"
                                               asp-route-SortOrder="@jobCountSortOrder"
                                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                               asp-route-Size="@Model.Filter.Size"
                                               class="flex items-center">
                                                Job count
                                                @if (Model.Filter.SortBy?.ToLower() == "jobcount")
                                                {
                                                    @if (Model.Filter.SortOrder?.ToLower() == "desc")
                                                    {
                                                        <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd"></path></svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                                                    }
                                                }
                                                else
                                                {
                                                    <svg class="w-4 h-4 ml-1 text-gray-400 opacity-50" fill="currentColor" viewBox="0 0 20 20"><path d="M5 10a1 1 0 011-1h8a1 1 0 110 2H6a1 1 0 01-1-1z"></path></svg>
                                                }
                                            </a>
                                        </th>
                                <th scope="col" class="p-4  text-left text-xs font-medium text-gray-500 uppercase">
                                    Action
                                </th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            @if (Model.JobCategories.Items.Any())
                            {
                                @foreach (var category in Model.JobCategories.Items ?? [])
                                {
                                    <tr class="hover:bg-gray-100">
                                        <td class="p-4 w-4">
                                            <div class="flex items-center">
                                                <input id="checkbox-@category.Id" type="checkbox" class="bg-gray-50 border-gray-300 focus:ring-3 focus:ring-cyan-200 h-4 w-4 rounded">
                                            </div>
                                        </td>
                                        <td class="p-4 whitespace-nowrap text-sm font-normal text-gray-500">
                                            <div class="text-base font-semibold text-gray-900">@category.Name</div>
                                        </td>
                                        <td class="p-4 whitespace-nowrap text-sm font-normal text-gray-500">
                                            @category.CreatedAt.ToString("dd MMM yyyy")
                                                </td>
                                        <td class="p-4 whitespace-nowrap text-sm font-normal text-gray-500">
                                            @category.JobIds.Count()
                                                </td>
                                        <td class="p-4 whitespace-nowrap space-x-2">
                                            <a asp-controller="jobCategory" asp-action="update" asp-route-id="@category.Id" class="text-white bg-cyan-600 hover:bg-cyan-700 focus:ring-4 focus:ring-cyan-200 font-medium rounded-lg text-sm inline-flex items-center px-3 py-2 text-center">
                                                <svg class="mr-2 h-5 w-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z"></path><path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" clip-rule="evenodd"></path></svg>
                                                Edit item
                                            </a>
                                            <a asp-controller="jobCategory" asp-action="details" asp-route-id="@category.DetailsUrl" class="text-white bg-cyan-600 hover:bg-cyan-700 focus:ring-4 focus:ring-cyan-200 font-medium rounded-lg text-sm inline-flex items-center px-3 py-2 text-center">
                                                <svg class="mr-2 h-5 w-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z"></path><path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" clip-rule="evenodd"></path></svg>
                                                Details
                                            </a>
                                            <a href="#" data-modal-toggle="delete-jobCategory-@category.Id" data-bs-target="delete-jobCategory-@category.Id" class="text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm inline-flex items-center px-3 py-2 text-center">
                                                <svg class="mr-2 h-5 w-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg>
                                                Delete item
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="p-4 text-center text-gray-500">
                                        No categories found matching your search criteria.
                                    </td>
                                </tr>
                            }
                                </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

        @{
            var routeData = new Dictionary<string, string>
                {
                { "size", Model.JobCategories.Size.ToString() },
                { "SortBy", Model.Filter?.SortBy ?? "" },
                { "SortOrder", Model.Filter?.SortOrder ?? "" }
                };

            ViewData["RouteData"] = routeData;
        }

<!-- Pagination -->
    <partial name="_PaginationPartial" model="@Model.JobCategories" />

    <input type="hidden" name="Index" id="Index" value="@Model.Filter?.Index" />
    <input type="hidden" name="Size" value="@Model.Filter?.Size" />
    <input type="hidden" name="SortOrder" value="@Model.Filter?.SortOrder" />

</form>
<!-- Add Product Modal -->
<div class="hidden overflow-x-hidden overflow-y-auto fixed top-4 left-0 right-0 md:inset-0 z-50 justify-center items-center h-modal sm:h-full" id="add-jobCategory-modal">
    <div class="relative w-full max-w-2xl px-4 h-full md:h-auto">
        <!-- Modal content -->
        <div class="bg-white rounded-lg shadow relative">
            <!-- Modal header -->
            <div class="flex items-start justify-between p-5 border-b rounded-t">
                <h3 class="text-xl font-semibold">
                    Add category
                </h3>
                <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center" data-modal-toggle="add-jobCategory-modal">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>  
                </button>
            </div>
            <!-- Modal body -->
            <div class="p-6 space-y-6">
                        <form method="post" enctype="multipart/form-data" asp-controller="jobCategory" asp-action="Create">
                    <div class="grid grid-cols-6 gap-6">
                        @if (Model.Languages.Any())
                        {
                            @for (int i = 0; i < Model.Languages.Count; i++)
                            {
                                <div class="col-span-6 sm:col-span-3">
                                    <label for="product-name" class="text-sm font-medium text-gray-900 block mb-2"><img src="@Model.Languages[i].IconUrl">  Name:</label>
                                    <input name="Translations[@i].LanguageId" value="@Model.Languages[i].Id" type="hidden" />
                                    <input name="Translations[@i].Name" id="product-name" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5" placeholder="Category name...." >
                                </div>
                            }
                        }
                        <div class="col-span-6 sm:col-span-3">
                             <label for="category" class="text-sm font-medium text-gray-900 block mb-2">Image</label>
                                    <input type="file" accept="image/*" name="ImageFile" id="category" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5" placeholder="Electronics">
                        </div>                
                    </div>                
                <!-- Modal footer -->
                <div class="p-6 border-t border-gray-200 rounded-b">
                    <button class="text-white bg-cyan-600 hover:bg-cyan-700 focus:ring-4 focus:ring-cyan-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center" type="submit">Add category</button>
                </div>
                </form>
             </div>
        </div>
    </div>
</div>

<!-- Delete Product Modal -->
@foreach (var category in Model.JobCategories.Items ?? [])
{
            <div class="hidden overflow-x-hidden overflow-y-auto fixed top-4 left-0 right-0 md:inset-0 z-50 justify-center items-center h-modal sm:h-full" id="delete-jobCategory-@category.Id">
        <div class="relative w-full max-w-md px-4 h-full md:h-auto">
            <!-- Modal content -->
            <div class="bg-white rounded-lg shadow relative">
                <!-- Modal header -->
                <div class="flex justify-end p-2">
                            <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center" data-modal-toggle="delete-jobCategory-@category.Id">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                    </button>
                </div>
                <!-- Modal body -->
                @if (!category.JobIds.Any() || category.JobIds.Count() == 0)
                {
                    <div class="p-6 pt-0 text-center">
                        <svg class="w-20 h-20 text-red-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <h3 class="text-xl font-normal text-gray-500 mt-5 mb-6">Are you sure you want to delete this category?</h3>
            <form method="post" asp-controller="jobCategory" asp-action="Delete" asp-route-id="@category.Id" style="display:inline;">
                <button type="submit" class="text-white bg-red-600 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-base inline-flex items-center px-3 py-2.5 text-center mr-2">
                    Yes, I'm sure
                </button>
            </form> 
            <a href="#" class="text-gray-900 bg-white hover:bg-gray-100 focus:ring-4 focus:ring-cyan-200 border border-gray-200 font-medium inline-flex items-center rounded-lg text-base px-3 py-2.5 text-center" data-modal-toggle="delete-jobCategory-@category.Id">
                    No, cancel
            </a>
                    </div>
                }
                else
                {
                    <div class="p-6 pt-0 text-center">
                        <svg class="w-20 h-20 text-red-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <h3 class="text-xl font-normal text-gray-500 mt-5 mb-6">You cant delete</h3>
                        <a href="#" class="text-gray-900 bg-white hover:bg-gray-100 focus:ring-4 focus:ring-cyan-200 border border-gray-200 font-medium inline-flex items-center rounded-lg text-base px-3 py-2.5 text-center" data-modal-toggle="delete-jobCategory-@category.Id">
                            Ok
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

    </main>

