@model CandidateDashboardViewModel
<!-- ========== Dashboard Area end============= -->
<div class="dashboard-area pt-120 mb-120">
    <div class="container">
        <div class="row g-lg-4 gy-5 mb-90">
            <div class="col-lg-3">
                <div class="dashboard-sidebar">
                    <partial name="_CandidateSidebarPartial" model="@Model" />
                </div>
            </div>
            <div class="col-lg-9">
                <div class="edit-profile-inner">
                    <div class="form-wrapper">             
                            <ul class="nav nav-tabs" id="myTab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <a asp-controller="candidate" asp-action="personalInfoUpdate" class="nav-link" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button"
                                            role="tab" aria-controls="home" aria-selected="true">
                                        <span></span>Basic Information:
                                    </a>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <a asp-controller="candidate" asp-action="profileUpdate" class="nav-link active" id="profile-tab" type="button"
                                       role="tab" aria-controls="profile" aria-selected="false">
                                        <span></span>Profile
                                    </a>

                                </li>
                                <li class="nav-item" role="presentation">
                                    <a asp-controller="candidate" asp-action="EducationUpdate" class="nav-link" id="contact-tab" type="button"
                                            role="tab" aria-controls="contact" aria-selected="false">
                                        <span></span>Education
                                    </a>
                                </li>
                                <li class="nav-item" role="presentation">
                                <a asp-controller="candidate" asp-action="experienceUpdate" class="nav-link" id="professional-tab" type="button"
                                            role="tab" aria-controls="professional" aria-selected="false">
                                        <span></span>Professional Info
                                    </a>
                                </li>
                            </ul>
                        <div class="tab-content" id="myTabContent">
                            <div class="tab-pane fade show active" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                           <form asp-controller="candidate" asp-action="profileTranslationUpdate" class="edit-profile-form profile-form">
                            <div class="action-btn-group">
                                <ul>
                                    @foreach (var language in Model.ReadyLanguages)
                                    {
                                        <li>
                                            <div class="add-row">
                                                <button type="button" onclick="updateProfileTranslation(@language.Id)">
                                                    <span>
                                                        <img src="~/images/icon/edit2.svg" alt="">
                                                        <span><img src="@language.IconUrl" alt="">Edit Translation</span>
                                                    </span>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                                <div id="profileTranslation" class="row">                       
                                </div>
                            </div>
                                </form>
                            </div>
                        </div>
                    
            </div>
                    
        </div>
    </div>
</div>
</div>
</div>
<!-- ========== Dashboard Area end============= -->
<script>
    function updateProfileTranslation(id){
        console.log(id);

        const profileTranslation = document.getElementById('profileTranslation');
        fetch(`/candidate/ProfileTranslationUpdate/${id}`)
             .then(response => response.text())
        .then(html => {
            console.log(html);
            profileTranslation.innerHTML = "";
            profileTranslation.innerHTML = html;
        });

        }
    function cancelProfileTranslationUpdate() {
        const profileTranslation = document.getElementById("profileTranslation");
        profileTranslation.innerHTML="";
    }

</script>