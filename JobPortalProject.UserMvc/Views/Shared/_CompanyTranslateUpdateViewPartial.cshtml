@model CompanyTranslationEditPageViewModel


<input asp-for="LangaugeId" value="@Model.LangaugeId" type="hidden" />
<div class="section-title2">
    <h5>Company Details:</h5>
</div>
 <input asp-for="CompanyTranslationUpdateViewModel.TranslationId" value="@Model.CompanyTranslationUpdateViewModel.TranslationId" type="hidden"> 
<div class="col-md-6">
    <div class="form-inner mb-25">
        <label for="companyname">Company Name*</label>
        <div class="input-area">
            <img src="~/images/icon/company-2.svg" alt="">
              <input asp-for="CompanyTranslationUpdateViewModel.Name" id="companyname" placeholder="Elite Hangstroman" />
              <span asp-validation-for="CompanyTranslationUpdateViewModel.Name"></span>
        </div>
    </div>
</div>
<div class="col-md-12">
    <div class="form-inner mb-40">
        <label for="description">Description*</label>
            <textarea asp-for="CompanyTranslationUpdateViewModel.Description" placeholder="Company Details*"></textarea> 
            <span asp-validation-for="CompanyTranslationUpdateViewModel.Description"></span>
    </div>
</div>
<div id="workingFieldRow" class="row">
    <partial name="_WorkingFieldsUpdatePartial" model="@Model" />
</div>

<div id="addressRow" class="row">
    <partial name="_AddressUpdatePartial" model="@Model" />
</div>

      
<div class="col-md-12">     
    <div class="form-inner">
        <button class="primry-btn-2 lg-btn w-unset"  type="submit">Update Translation</button>
        <button class="primry-btn-2 lg-btn w-unset" onclick="cancelCompanyTranslationUpdate()" type="button">Cancel</button>
    </div>
</div>
