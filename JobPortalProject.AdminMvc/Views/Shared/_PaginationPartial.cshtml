@using JobPortalProject.BL.ViewModels.Pagination
@model PagedResultBaseModel
<div class="bg-white sticky sm:flex items-center w-full sm:justify-between bottom-0 right-0 border-t border-gray-200 p-4">
    <div class="flex items-center mb-4 sm:mb-0">
        <span class="text-sm font-normal text-gray-500">
            Showing
            <span class="text-gray-900 font-semibold">@(Model.Count > 0 ? (Model.Index * Model.Size + 1) : 0)-@(Math.Min((Model.Index + 1) * Model.Size, Model.Count))</span>
            of
            <span class="text-gray-900 font-semibold">@Model.Count</span>
        </span>
    </div>

    <div class="flex items-center space-x-1">
        @{
            var currentPage = Model.Index;
            var totalPages = (int)Math.Ceiling((double)Model.Count / Model.Size);
            var pageNumbers = new List<int?>();

            // Always show first page

            pageNumbers.Add(0);

            // Show pages around current page
            if (currentPage > 3)
            {
                pageNumbers.Add(null);
            }

            for (int i = Math.Max(1, currentPage - 1); i <= Math.Min(totalPages - 2, currentPage + 1); i++)
            {
                if (i > 0 && i < totalPages - 1)
                {
                    pageNumbers.Add(i);
                }
            }

            if (currentPage < totalPages - 4)
            {
                pageNumbers.Add(null);
            }
            if (totalPages > 1)
            {
                pageNumbers.Add(totalPages - 1);
            }
        }

        @* Previous Button *@

        @if (Model.HasPrevious)
        {
            <a asp-action="Index" asp-route-index="@(Model.Index - 1)" asp-route-size="@Model.Size"
               @* asp-route-searchTerm="@Model.Filter?.SearchTerm" *@ class="px-3 py-2 text-gray-500 hover:text-gray-900 hover:bg-gray-100 rounded-lg">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">

                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                </svg>
            </a>
        }
        else
        {
            <span class="px-3 py-2 text-gray-300 cursor-not-allowed rounded-lg">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
                     xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                </svg>
            </span>
        }
        @* Page Numbers *@

        @foreach (var pageNum in pageNumbers)
        {
            @if (pageNum == null)
            {
                <span class="px-3 py-2 text-gray-500">...</span>
            }
            else if (pageNum == currentPage)
            {
                <span class="px-3 py-2 text-white bg-cyan-600 rounded-lg font-medium">@(pageNum + 1)</span>
            }
            else
            {
                <a asp-action="Index" asp-route-index="@pageNum" asp-route-size="@Model.Size"  @* asp-route-searchTerm="@Model.Filter?.SearchTerm"  *@ class="px-3 py-2 text-gray-700 hover:bg-gray-100 rounded-lg hover:text-gray-900"> @(pageNum + 1)  </a>
            }
        }
        @* Next Button *@

        @if (Model.HasNext)
        {
            <a asp-action="Index" asp-route-index="@(Model.Index + 1)" asp-route-size="@Model.Size" @* asp-route-searchTerm="@Model.Filter?.SearchTerm" *@ class="px-3 py-2 text-gray-500 hover:text-gray-900 hover:bg-gray-100 rounded-lg">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">

                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
            </a>
        }
        else
        {
            <span class="px-3 py-2 text-gray-300 cursor-not-allowed rounded-lg">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
            </span>
        }
    </div>
</div>
