@model WorkingFieldCreateViewModel

<div class="dashboard-area company-dashboard pt-120 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 mb-50">
                <partial name="_SidebarPartial" model="@Model.SelectedUpdateLanguageId" />
            </div>
            <div class="col-lg-12">
                <div class="my-profile-inner ">

                    <div class="form-wrapper">
                        <div class="section-title two">
                            <h5>Add Working Field</h5>
                            <div class="dash"></div>
                        </div>
                        <form method="post" class="profile-form" enctype="multipart/form-data">
                            <input asp-for="SelectedUpdateLanguageId" value="@Model.SelectedUpdateLanguageId" type="hidden" />
                            <div id="workingField" class="work-area-row">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-inner mb-25">
                                            <label>Add Icon*</label>
                                            <div class="input-area">
                                                <img src="~/images/icon/company-2.svg" alt="">
                                                <input asp-for="IconFile" accept="image/*">
                                                <span asp-validation-for="IconFile"></span>
                                            </div>
                                        </div>
                                    </div>
                                    @for (int i = 0; i < Model.CompanyTranslationsCount; i++)
                                    {
                                        <input asp-for="WorkingFieldTranslationCreateViewModels[i].LanguageId" 
                                        value="@Model.WorkingFieldTranslationCreateViewModels[i].LanguageId" type="hidden" />
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <div class="section-title two">
                                                    <div class="dash"></div>
                                                </div>

                                                <label for="name">Working Field*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/company-2.svg" alt="">
                                                    <input asp-for="WorkingFieldTranslationCreateViewModels[i].Name" id="working-field" placeholder="Frontend Developer" />
                                                    <span asp-validation-for="WorkingFieldTranslationCreateViewModels[i].Name"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-inner mb-40">
                                                <label for="description">Short Description*</label>
                                                <input asp-for="WorkingFieldTranslationCreateViewModels[i].Description" id="description" placeholder="Details*" />
                                                <span asp-validation-for="WorkingFieldTranslationCreateViewModels[i].Description"></span>
                                            </div>
                                        </div>
                                    }

                                    <div class="col-md-12">
                                        <div class="form-inner">
                                            <button class="primry-btn-2 lg-btn w-unset" type="submit">Add</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <br />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

