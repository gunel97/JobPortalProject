@model EducationPageCreateViewModel

<!-- ========== Dashboard Area end============= -->
<div class="dashboard-area pt-120 mb-120">
    <div class="container">
        <div class="row g-lg-4 gy-5 mb-90">
            <div class="col-lg-3">
                <div class="dashboard-sidebar">
                    <partial name="_CandidateSidebarPartial" model="@Model.DashboardModel" />
                </div>
            </div>
            <div class="col-lg-9">
                <div class="edit-profile-inner">

                    <div class="form-wrapper">
                        <partial name="_ResumeSidebarPartial" />
                        <div class="tab-content" id="myTabContent">

                            <div class="tab-pane fade" id="home" role="tabpanel" aria-labelledby="home-tab">
                            </div>
                            <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                            </div>
                            <div class="tab-pane fade show active" id="contact" role="tabpanel" aria-labelledby="contact-tab">
                                <form method="post" class="edit-profile-form profile-form">
                                    <input asp-for="LanguageId" value="@Model.LanguageId" type="hidden" />
                                    <div class="section-title2">
                                        <h5>Educational Qualification:</h5>
                                    </div>
                                    @for(int i=0; i<Model.Models.Count(); i++){
                                        <input asp-for="Models[i].IdForTranslation" value="@Model.Models[i].IdForTranslation" type="hidden" />
                                        <div id="educationRow" class="education-row">
                                            <div class="col-lg-12">
                                                <div class="info-title">
                                                    <h6>Academic Information:</h6>
                                                    <div class="dash"></div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-inner mb-25">
                                                    <label>Education Level*</label>
                                                    <div class="input-area">
                                                        <img src="/images/icon/qualification-2.svg" alt="">
                                                        <label>@Model.Models[i].EducationTypeId</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-inner mb-25">
                                                    <label>My Major*</label>
                                                    <div class="input-area">
                                                        <img src="/images/icon/major.svg" alt="">
                                                        <input asp-for="Models[i].MajorName" id="institute" placeholder="Type Your Major Name...">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-inner mb-25">
                                                    <label for="institute">Institute/University*</label>
                                                    <div class="input-area">
                                                        <img src="/images/icon/univercity.svg" alt="">
                                                        <input asp-for="Models[i].SchoolName" id="institute" placeholder="Type Your Institute Name...">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-inner mb-20">
                                                    <label for="datepicker10">Starting Period*</label>
                                                    <div class="input-area">
                                                        <img src="/images/icon/calender2.svg" alt="">
                                                        <label>@Model.Models[i].StartDate.Date.ToShortDateString()</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-inner mb-20">
                                                    <label for="datepicker11">Ending Period*</label>
                                                    <div class="input-area">
                                                        <img src="/images/icon/calender2.svg" alt="">
                                                        <label>@Model.Models[i].EndDate.Date.ToShortDateString()</label>
                                                    </div>
                                                </div>
                                            </div>`
                                        </div>
                                    }
                                    <div id="saveButtonEdu" class="col-md-12">
                                        <div class="form-inner">
                                            <button class="primry-btn-2 lg-btn w-unset" type="submit">Save</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <div class="tab-pane fade" id="professional" role="tabpanel" aria-labelledby="professional-tab">
                            </div>
                        </div>

                    </div>



                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Dashboard Area end============= -->
