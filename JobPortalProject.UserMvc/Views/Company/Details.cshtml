@{
    CompanyDetailsViewModel model = Model;
    var company = model.Company;
    var companySocials = model.CompanySocials ?? [];
    // var website = model.Website;
    var addresses = model.Company?.Addresses ?? [];
    var workingAreas = model.Company?.WorkingFields ?? [];
    var jobs = model.ActiveJobs ?? [];
}

    <!-- ========== Inner Banner Start============= -->
    <div class="inner-banner">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="banner-content text-center">
                        <h1>Company Details</h1>
                        <span></span>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a asp-controller="home" asp-action="index">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Company Details</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ========== Inner Banner end============= -->
    <!-- ========== Job Details Start============= -->
    <div class="company-details-area pt-120 mb-120">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="post-thumb">
                        <img class="img-fluid" src="@company?.CoverPhotoUrl" alt="">
                        <div class="company-logo">
                            <img src="@company?.LogoUrl" alt="">
                        </div>
                    </div>
                    <div class="company-area">
                        <div class="company-info">
                            <h4>@company?.Name</h4>
                            <ul>
                                <li><img src="~/images/icon/map-2.svg" alt=""> @company?.MainAddress?.CityName, @company?.MainAddress?.CountryName</li>
                                <li><img src="~/images/icon/category-2.svg" alt=""><span class="title">Category: </span> @company?.CategoryName</li>
                            </ul>
                        </div>
                        <div class="company-contact">
                      @*       <div class="websitet-link">
                                <p><img src="~/images/icon/web-5.svg" alt="">Website Link:</p>
                                <a href="#">@website?.AddressUrl</a>
                            </div> *@
                            <div class="social-area">
                                <p><img src="~/images/icon/share-icon.svg" alt="">Follow Company:</p>
                                <ul>
                                @foreach (var social in companySocials ?? [])
                                {
                                    <li><a href="https://www.facebook.com/"><i class="bx bxl-@social.SocialMedia?.Title.ToLower()"></i></a></li>
                                }                  
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="company-details-content">
                                <h5>About Company</h5>
                               <p>@company?.Description</p>
                               <br><br>
                            @if (workingAreas.Count != 0){
                                  <h5>Working Areas</h5>                               
                                    <div class="row pt-20" id="workingField">
                                    @foreach (var field in workingAreas)
                                    {
                                        <div class="col-sm-6 mb-50">
                                            <div class="working-process">
                                                <div class="icon">
                                                    <img src="@field.IconUrl" alt="">
                                                </div>
                                                <div class="work-content">
                                                    <div class="sl"></div>
                                                    <h6>@field.Name</h6>
                                                    <p>@field.Description</p>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                 </div>
                                 }
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="company-dt-sb mb-60">
                                <div class="company-overview-area mb-50">
                                    <h5>Company Overview:</h5>
                                    <ul>
                                        <li><span>Company Name:</span> @company?.Name</li> 
                                         <li><span>Category:</span> @company?.CategoryName</li>
                                        <li><span>Primary phone:</span> @company?.PrimaryPhone</li> 
                                         @if(company?.SecondaryPhone!=null)
                                        {
                                            <li><span>Secondary phone:</span> @company?.SecondaryPhone</li>
                                        }

                                        <li><span>Locations:</span></li>
                                        @foreach(var address in company?.Addresses ?? [])
                                    {

                                        <li> 
                                            @if(address.IsMainAddress)
                                            {
                                            <span>(Main Location)</span>
                                            } 
                                            @address.Street, @address.CityName, @address.CountryName 
                                        </li>
                                    }
                                        <li><span>Member Since:</span> @company?.MemberSince!.Date.ToShortDateString()</li>
                                        <li><span>Company size:</span> @company?.CompanySize People.</li>      
                                        @if(company.LastPostedJob.HasValue){
                                        <li><span>Last Job Posted:</span> @company?.LastPostedJob.Value.Date.ToShortDateString()</li> 
                                        }
                                    </ul>
                                </div>
                                <a class="primry-btn-2 lg-btn" href="job-listing1.html">Job Available: @company?.ActiveJobCount</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        @if (jobs.Any())
        {
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title">
                        <h4>Latest Jobs:</h4>
                    </div>
                    @foreach (var job in jobs)
                    {
                        <partial name="_JobListingCardPartial" model="@job" />
                    }                
                </div>
            </div>
            }
        </div>
    </div>
    <!-- ========== Job Details end============= -->