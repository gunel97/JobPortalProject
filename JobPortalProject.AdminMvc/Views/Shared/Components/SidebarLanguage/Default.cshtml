@model TopHeaderViewModel
<li>
    <button type="button" class="flex items-center w-full p-2 text-base text-gray-900 font-normal rounded-lg transition duration-75 group hover:bg-gray-100" aria-controls="dropdown-language" id="sidebar-lang-toggle">
     <img src="@Model.SelectedLanguage?.IconUrl" />
        <span class="flex-1 ml-3 text-left whitespace-nowrap">Language</span>
        <svg id="sidebar-lang-arrow" class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
    </button>

    <ul id="dropdown-language" class="hidden py-2 space-y-2">
        @foreach (var language in Model.Languages ?? [])
        {
            <li>
                <a asp-controller="Localizer" asp-action="ChangeCulture" asp-route-culture="@language.IsoCode" class="flex items-center w-full p-2 text-base text-gray-900 transition duration-75 rounded-lg pl-11 group hover:bg-gray-100">
                <img src="@language.IconUrl" class="w-5 h-5 mr-2 rounded-full shadow-sm">
                @language.Name
            </a>
        </li>
        }
    </ul>
</li>