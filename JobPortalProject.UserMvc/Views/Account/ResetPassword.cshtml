@model ResetPasswordViewModel

<div class="login-area pt-120 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="form-wrapper">
                    <div class="form-title">
                        <h3>Reset Password</h3>
                        <span></span>
                    </div>
                    <form method="post">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-inner">
                                    <label for="email">New Password*</label>
                                    <input asp-for="NewPassword" id="password" placeholder="Password" />
                                    <span asp-validation-for="NewPassword"></span>
                                    <i class="bi bi-eye-slash" id="togglePassword"></i>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-inner">
                                    <label for="email">Confirm Password*</label>
                                    <input  asp-for="ConfirmPassword" id="password" placeholder="Password" />
                                    <span asp-validation-for="ConfirmPassword"></span>
                                    <i class="bi bi-eye-slash" id="togglePassword"></i>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-inner">
                                    <button class="primry-btn-2" type="submit">Change Password</button>
                                </div>
                            </div>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>