@model ChangePasswordViewModel
  <!-- ========== Dashboard Area end============= -->
<div class="dashboard-area pt-120 mb-120">
    <div class="container">
        <div class="row g-lg-4 gy-5 mb-90">
            <div class="col-lg-12">
                <div class="form-wrapper">
                    <form method="post" class="profile-form">
                        <div class="section-title2">
                            <h5 class="d-flex align-items-baseline gap-1"><img img src="~/images/icon/profile-settings.svg" alt=""> Profile Settings </h5>
                        </div>
                        <div class="change-password-area mb-40">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="info-title">
                                        <h6>Change Your Password</h6>
                                        <div class="dash"></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-inner mb-25">
                                        <label for="password">Current Password*</label>
                                        <div class="input-area">
                                            <img img src="~/images/icon/lock-2.svg" alt="">
                                            <input asp-for="CurrentPassword" id="password" placeholder="Password">
                                            <span asp-validation-for="CurrentPassword"></span>
                                            <i class="bi bi-eye-slash" id="togglePassword"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-inner mb-25">
                                        <label for="password">New Password*</label>
                                        <div class="input-area">
                                            <img img src="~/images/icon/lock-2.svg" alt="">
                                            <input asp-for="NewPassword" id="password" placeholder="Password">
                                            <span asp-validation-for="NewPassword"></span>
                                            <i class="bi bi-eye-slash" id="togglePassword"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-inner mb-25">
                                        <label for="password2">Confirm Password*</label>
                                        <div class="input-area">
                                            <img img src="~/images/icon/lock-2.svg" alt="">
                                            <input asp-for="ConfirmPassword" id="password2" placeholder="Confirm Password" />
                                            <span asp-validation-for="ConfirmPassword"></span>
                                            <i class="bi bi-eye-slash" id="togglePassword2"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-inner mb-25">
                                        <label for="pemail">Account Email*</label>
                                        <div class="input-area">
                                            <img img src="~/images/icon/email-2.svg" alt="">
                                            <input type="text" id="pemail" name="pemail" placeholder="info@example.com">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 pt-10">
                                    <div class="form-inner">
                                        <button class="primry-btn-1 lg-btn w-unset" asp-controller="account" asp-action="changepassword" type="submit">Update Change</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="phone-email-area">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="info-title">
                                        <h6>Phone & Email</h6>
                                        <div class="dash"></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-inner mb-25">
                                        <label for="pemail">Primary Email*</label>
                                        <div class="input-area">
                                            <img img src="~/images/icon/email-2.svg" alt="">
                                            <input type="text" id="pemail" name="pemail" placeholder="info@example.com">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 pt-10">
                                    <div class="form-inner">
                                        <button class="primry-btn-1 lg-btn w-unset" type="submit">Update Change</button>
                                    </div>
                                    <br />
                                </div>
                            </div>
                        </div>
                        <div class="privacy-security-area">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="info-title">
                                        <h6>Privacy & Security</h6>
                                        <div class="dash"></div>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="single-permission align-items-start">
                                        <div class="title">
                                            <h6>Delete Account</h6>
                                            <p>If you delete your account, you will no longer be able to get information about the matched jobs.</p>
                                        </div>
                                        <div class="delete-btn">
                                            <button type="reset">Delete Account</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Dashboard Area end============= -->