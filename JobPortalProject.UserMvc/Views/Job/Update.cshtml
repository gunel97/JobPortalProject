@model JobUpdateViewModel

<!-- ========== Inner Banner Start============= -->
<div class="inner-banner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="banner-content text-center">
                    <h1>Post A Jobs</h1>
                    <span></span>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Post A Jobs</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Inner Banner end============= -->
<!-- ========== Login Area end============= -->
<div class="job-post-area pt-120 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="form-wrapper">
                    <form method="post">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="section-title2">
                                    <h5>Job Information:</h5>
                                 <input asp-for="Id" value="@Model.Id" type="hidden" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label>Job Category*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/category-2.svg" alt="">
                                        <select asp-items="Model.JobCategoriesList" asp-for="JobCategoryId" class="select1">
                                        </select>
                                        <span asp-validation-for="JobCategoryId"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label>Job Type*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/company-2.svg" alt="">
                                        <select asp-items="Model.JobTypeListItems" asp-for="JobTypeId" class="select1">
                                        </select>
                                        <span asp-validation-for="JobTypeId"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label>Gender*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/company-2.svg" alt="">
                                        <select asp-items="Model.GenderListItems" asp-for="GenderId" class="select1">
                                        </select>
                                        <span asp-validation-for="GenderId"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label>Location</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/company-2.svg" alt="">
                                        <select asp-items="Model.AddressesList" asp-for="AddressId" class="select1">
                                        </select>
                                        <span asp-validation-for="AddressId"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label>Required Education Type</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/company-2.svg" alt="">
                                        <select asp-items="Model.RequiredEducationTypeListItems" asp-for="RequiredEducationTypeId" class="select1">
                                        </select>
                                        <span asp-validation-for="RequiredEducationTypeId"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label>Salary Type*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/category-2.svg" alt="">
                                        <select asp-items="Model.SalaryTypeListItems" asp-for="SalaryTypeId" class="select1">
                                        </select>
                                        <span asp-validation-for="SalaryTypeId"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label>Min Salary*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/salary-2.svg" alt="">
                                        <input asp-for="MinSalary" placeholder="Min Salary">
                                        <span asp-validation-for="MinSalary"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label>Max Salary*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/salary-2.svg" alt="">
                                        <input asp-for="MaxSalary" placeholder="Max Salary">
                                        <span asp-validation-for="MaxSalary"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label for="datepicker9">Deadline*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/calender2.svg" alt="">
                                        <input asp-for="ExpirationDate" id="datepicker9" placeholder="MM/DD/YY">
                                        <span asp-validation-for="ExpirationDate"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label for="vacancies">Vacancies*</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/user-2.svg" alt="">
                                        <input asp-for="VacancyCount" id="vacancies" placeholder="07 Person">
                                        <span asp-validation-for="VacancyCount"></span>
                                    </div>
                                </div>
                            </div>
                            @for (int i = 0; i < Model.JobTranslations.Count(); i++)
                            {
                                <div class="col-lg-12">
                                    <div class="section-title2">
                                        <h5>  <img src="@Model.JobTranslations[i].LanguageIcon" alt="">  Job Details Translation:</h5>
                                    </div>
                                </div>
                                <input asp-for="JobTranslations[i].LanguageId"
                                       value="@Model.JobTranslations[i].LanguageId" type="hidden" />
                                       <input asp-for="JobTranslations[i].Id" value="@Model.JobTranslations[i].Id" type="hidden" />
                                <div class="col-md-6">
                                    <div class="form-inner mb-25">
                                        <label for="jobtitle">Job Title*</label>
                                        <div class="input-area">
                                            <img src="~/images/icon/company-2.svg" alt="">
                                            <input asp-for="JobTranslations[i].Title" id="jobtitle" placeholder="Senior UI/UX Engineer">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-inner mb-25">
                                        <label for="experiences">Experience Level*</label>
                                        <div class="input-area">
                                            <img src="~/images/icon/email-2.svg" alt="">
                                            <input asp-for="JobTranslations[i].RequiredExperience" id="experiences" placeholder="Type Experiences">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-inner mb-25">
                                        <label for="jobtitle">Job Description*</label>
                                        <div class="input-area">
                                            <img src="~/images/icon/company-2.svg" alt="">
                                            <input asp-for="JobTranslations[i].Description" id="description" placeholder="Senior UI/UX Engineer">
                                        </div>
                                    </div>
                                </div>
                            }
                               @if (Model.ExtraBenefits.Any())
                            {
                                <div id="jobBenefitRow" class="row">
                                    <partial name="_BenefitsUpdatePartial" model="@Model.ExtraBenefits" />
                                </div>
                            }
                            @if (Model.Responsibilities.Any())
                            {
                                <div id ="jobResponsibilityRow" class="row">
                                    <partial name="_ResponsibilitiesUpdatePartial" model="@Model.Responsibilities" />
                                </div>
                            }

                            <br />
                            <div class="add-remove-btn d-flex align-items-center justify-content-between mb-50">
                                <div class="add-row">
                                    <button type="button" class="addwork-area-row">Add Extra Benefit</button>
                                </div>
                                <div class="add-row">
                                    <button data-bs-toggle="modal" data-bs-target="#addResponsibilityModal" type="button" class="addwork-area-row">Add Responsibility</button>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <br />
                                <div class="form-inner">
                                    <button class="primry-btn-2 lg-btn w-unset" type="submit">Post Now</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

    <!-- ========== Login Area end============= -->

<!-- ========== Add responsibility modal============= -->
<div class="modal fade" id="addResponsibilityModal" tabindex="-1" aria-labelledby="addResponsibilityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addResponsibilityModalLabel">Add Job Responsibility</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-action="AddResponsibility" asp-controller="Job">
                <div class="modal-body">
                    <input type="hidden" name="JobId" value="@Model.Id" />

                    @if (Model.JobTranslations != null && Model.JobTranslations.Any())
                    {
                        <div class="col-lg-12 mb-3">
                            <h6>Translations:</h6>
                        </div>

                        @for (int i = 0; i < Model.JobTranslations.Count; i++)
                        {
                            <div class="form-inner mb-25">
                                <label><img src="@Model.JobTranslations[i].LanguageIcon" alt="" /></label>
                                <div class="col-md-6">  
                                        <div class="input-area">
                                            <img src="~/images/icon/company-2.svg" alt="">
                                        <input name="JobResponsibilityTranslations[@i].LanguageId" value="@Model.JobTranslations[i].LanguageId" type="hidden" />
                                        <input name="JobResponsibilityTranslations[@i].Value" placeholder="Add Responsibility" class="form-control">
                                        </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Responsibility</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ========== Add responsibility modal end============= -->

@if (TempData["CloseModal"] != null)
{
    <script>
        // Close the modal on page load
        document.addEventListener('DOMContentLoaded', function() {
            var modal = bootstrap.Modal.getInstance(document.getElementById('addResponsibilityModal'));
            if (modal) {
                modal.hide();
            }

            // Optional: Show success message
            @if (TempData["Success"] != null)
            {
                    <text>
                    alert('@TempData["Success"]');
                    </text>
            }
        });
    </script>
}


