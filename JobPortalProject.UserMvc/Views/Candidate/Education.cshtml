@model EducationPageCreateViewModel

<!-- ========== Dashboard Area end============= -->
<div class="dashboard-area pt-120 mb-120">
    <div class="container">
        <div class="row g-lg-4 gy-5 mb-90">
            <div class="col-lg-3">
                <div class="dashboard-sidebar">
                    <partial name="_CandidateSidebarPartial" model="@Model.DashboardModel"/>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="edit-profile-inner">
                    <div class="form-wrapper">
                        <partial name="_ResumeSidebarPartial" />
                        <div class="tab-content" id="myTabContent">

                            <div class="tab-pane fade" id="home" role="tabpanel" aria-labelledby="home-tab">
                            </div>
                            <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                            </div>
                            <div class="tab-pane fade show active" id="contact" role="tabpanel" aria-labelledby="contact-tab">
                                <form asp-controller="candidate" asp-action="education" class="edit-profile-form profile-form">
                                   <input asp-for="LanguageId" value="@Model.LanguageId" type="hidden" />
                                    <div class="section-title2">
                                        <h5>Educational Qualification:</h5>
                                    </div>
                                    <div id="educationRow" class="education-row">
                                      
                                    </div>                                    
                                    <div class="col-md-6">
                                        <div class="form-inner">
                                            <button onclick='addEducation(@Html.Raw(Json.Serialize(Model.Models)))' class="primry-btn-2 lg-btn w-unset" type="button">Add + </button>
                                        </div>
                                    </div>
                                    <br/>
                                    <div id="removeButtonEdu" class="col-md-6">
                                    </div>
                                    <br/>
                                    <div id="saveButtonEdu" class="col-md-12">                                        
                                    </div>
                                </form>
                            </div>
                            <div class="tab-pane fade" id="professional" role="tabpanel" aria-labelledby="professional-tab">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Dashboard Area end============= -->

<script>
    var educationLevelOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.EducationTypes.Select(x => new { value = x.Value, text = x.Text })
            ))
</script>