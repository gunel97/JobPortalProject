@model UserViewModel


<div id="main-content" class="h-full w-full bg-gray-50 relative overflow-y-auto lg:ml-64">
    <main>

        <br />
        <div class="relative w-full max-w-2xl px-4 h-full md:h-auto">
            <div class="bg-white rounded-lg shadow relative">
                <div class="flex items-start justify-between p-5 border-b rounded-t">
                    <h3 class="text-xl font-semibold">
                        User Details
                    </h3>
                </div>
                <!-- Modal body -->
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-6 gap-6">
                        <div class="col-span-6 sm:col-span-3">
                            <label id="product-name" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5">
                                <b> Firstname: </b> @Model.FirstName
                            </label>
                        </div>
                        <div class="col-span-6 sm:col-span-3">
                            <label id="product-name" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5">
                                <b>Lastname: </b> @Model.LastName
                            </label>
                        </div>
                        <div class="col-span-6 sm:col-span-3">
                            <label id="product-name" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5">
                                <b>Email: </b> @Model.Email
                            </label>
                        </div>
                        <div class="col-span-6 sm:col-span-3">
                            <label id="product-name" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5">
                                <b>Username: </b> @Model.UserName
                            </label>
                        </div>
                        <div class="col-span-6 sm:col-span-3">
                            <label id="product-name" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5">
                                <b>Role: </b> @Model.Role
                            </label>
                        </div>
                        <div class="col-span-6 sm:col-span-3">
                            <label id="product-name" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5">
                                <b>Created At: </b> @Model.CreatedAt.Date.ToShortDateString()
                            </label>
                        </div>
                    </div>
                    <div class="p-6 border-t border-gray-200 rounded-b">
                        @if (Model.Role != null)
                        {
                            @if (Model.Role.ToLower() != "candidate" && Model.Role.ToLower() != "company")
                            {
                                <a asp-controller="user" asp-action="update" asp-route-id="@Model.Id" class="text-white bg-cyan-600 hover:bg-cyan-700 focus:ring-4 focus:ring-cyan-200 font-medium rounded-lg text-sm inline-flex items-center px-3 py-2 text-center">
                                    Edit item
                                </a>
                            }
                            @if (Model.Role.ToLower() == "company")
                            {
                                <a asp-controller="company" asp-action="details" asp-route-listName="userList"
                                asp-route-page="@ViewBag.Index" asp-route-id="@Model.Id" 
                                class="text-white bg-cyan-600 hover:bg-cyan-700 focus:ring-4 focus:ring-cyan-200 font-medium rounded-lg text-sm inline-flex items-center px-3 py-2 text-center">
                                    View Company Details
                                </a>
                            }
                            @if (Model.Role.ToLower() == "candidate")
                            {
                                <a asp-controller="candidate" asp-action="details"  asp-route-id="@Model.Id"
                                asp-route-listName="userList" asp-route-page="@ViewBag.Index"
                                class="text-white bg-cyan-600 hover:bg-cyan-700 focus:ring-4 focus:ring-cyan-200 font-medium rounded-lg text-sm inline-flex items-center px-3 py-2 text-center">
                                    View Candidate Details
                                </a>
                            }
                        }
                        <a asp-controller="user" asp-action="index" asp-route-page="@ViewBag.Index" 
                        asp-route-role="@ViewBag.Role" class="text-white bg-cyan-600 hover:bg-cyan-700 focus:ring-4 focus:ring-cyan-200 font-medium rounded-lg text-sm inline-flex items-center px-3 py-2 text-center">
                            Back to list
                        </a>
                    </div>
                </div>
            </div>
        </div>
