@model ExperiencePageCreateViewModel

<!-- ========== Dashboard Area end============= -->
<div class="dashboard-area pt-120 mb-120">
    <div class="container">
        <div class="row g-lg-4 gy-5 mb-90">
            <div class="col-lg-3">
                <div class="dashboard-sidebar">
                    <partial name="_CandidateSidebarPartial" model="@Model.DashboardViewModel" />
                </div>
            </div>
            <div class="col-lg-9">
                <div class="edit-profile-inner">

                    <div class="form-wrapper">
                        <partial name="_ResumeSidebarPartial" />
                        <div class="tab-content" id="myTabContent">
                            <div class="tab-pane fade" id="home" role="tabpanel" aria-labelledby="home-tab">
                            </div>
                            <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                            </div>
                            <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab">
                            </div>
                            <div class="tab-pane fade show active" id="professional" role="tabpanel" aria-labelledby="professional-tab">
                                <form asp-controller="candidate" asp-action="experience" class="edit-profile-form profile-form">
                                    <input asp-for="LanguageId" asp-items="@Model.LanguageId" type="hidden" />
                                    <div class="section-title2">
                                        <h5>Employment Information:</h5>
                                    </div>
                                    <div id="experienceRow" class="experiences-row">
                                        <div class="row">
                                         
                                        </div>
                                    </div>
                                  @*   <div class="add-remove-btn d-flex align-items-center justify-content-between mb-50">
                                        <div class="add-row">
                                            <button type="button" class="add-experiences-row">Add New+ </button>
                                        </div>
                                    </div> *@
                                    <div class="col-md-12">
                                        <div class="form-inner">
                                            <button class="primry-btn-2 lg-btn w-unset" onclick='addExperience(@Html.Raw(Json.Serialize(Model.Models)))' type="button">Add Experience</button>
                                        </div>
                                    </div>
                                    <br/>
                                    <div id="removeButtonExp" class="col-md-12">
                                        
                                    </div>
                                    <br/>
                                    <div id="saveButtonExp" class="col-md-12">
                                     
                                    </div>
                                </form>

                            </div>
                        </div>

                    </div>



                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Dashboard Area end============= -->

<script>
    let expIndex=0;
    const removeButtonExp = document.getElementById('removeButtonExp');
    const saveButtonExp = document.getElementById('saveButtonExp');

function addExperience(models){
    console.log(models);
    const experienceRow = document.getElementById('experienceRow');
    const divElement = document.createElement('div');

    divElement.className = 'row';
    divElement.id = `expRow${expIndex}`;

    var htmlTextExp = `   <div class="col-lg-12">
                                                <div class="info-title">
                                                    <h6>Add Your Experiences</h6>
                                                    <div class="dash"></div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-inner mb-25">
                                                    <label for="companies">Company Name*</label>
                                                    <div class="input-area">
                                                        <img src="/images/icon/company-2.svg" alt="">
                                                        <input type="text" id="companies" name="models[${expIndex}].Translation.CompanyName" placeholder="Egenslab">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-inner mb-25">
                                                    <label for="companies">Position*</label>
                                                    <div class="input-area">
                                                        <img src="/images/icon/designation-2.svg" alt="">
                                                        <input type="text" id="companies" name="models[${expIndex}].Translation.Position" placeholder="Position">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-inner mb-20">
                                                    <label for="datepicker6">Starting Period*</label>
                                                    <div class="input-area">
                                                        <img src="/images/icon/calender2.svg" alt="">
                                                        <input type="text" id="datepicker6" name="models[${expIndex}].StartDate" placeholder="DD/MM/YY">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-inner mb-20">
                                                    <label for="datepicker7">Ending Period*</label>
                                                    <div class="input-area">
                                                        <img src="/images/icon/calender2.svg" alt="">
                                                        <input type="text" id="datepicker7" name="models[${expIndex}].EndDate" placeholder="DD/MM/YY">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="form-inner mb-20">
                                                    <label for="description1">Responsibility**</label>
                                                    <textarea name="models[${expIndex}].Translation.Responsibility" id="description1" placeholder="Write Your Responsibility..."></textarea>
                                                </div>
                                            </div>`;

    divElement.innerHTML+=htmlTextExp;
    experienceRow.appendChild(divElement);
    console.log(htmlTextExp);
    expIndex++;

    saveButtonExp.innerHTML=`<div class="form-inner">
                                            <button class="primry-btn-2 lg-btn w-unset" type="submit">Save</button>
                                        </div>`;
    if(expIndex>1){
        removeButtonExp.innerHTML=`<div class="form-inner">
                                            <button class="primry-btn-2 lg-btn w-unset" onclick='removeExp()' type="button">Remove</button>
                                        </div>`;
    }
}

function removeExp(){
    if (expIndex == 1) {
        return;
    }

    var test = expIndex - 1;
    var rowExp = document.getElementById(`expRow${test}`);
    rowExp.remove();
    expIndex--;
    if (test == 1) {
        removeButtonExp.innerHTML = "";
    }
}

</script>