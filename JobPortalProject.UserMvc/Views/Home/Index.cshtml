@{
    HomeViewModel model = Model;
    var jobCategories = model.JobCategories;
    var addresses = model.Addresses;
    var companies = model.Companies;
    var jobs = model.Jobs;
    var companyCount = model.ActiveCompanyCount;
    var candidateCount = model.CandidateCount;
    var jobCount = model.ActiveJobCount;
    var newjobCount = model.NewJobCount;
    var jobCategoryItems = model.JobCategoryListItems;
}

    <!-- ========== Hero One Start============= -->
<div class="hero1">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="hero-content">
                    <h1>Your Career’s <span>Opportunity.</span></h1>
                    <div class="counter-area">
                        <div class="row g-lg-4 g-md-5 gy-5 justify-content-center">
                            <div class="col-lg-3 col-sm-6">
                                <div class="counter-single">
                                    <div class="counter-icon">
                                        <img src="~/images/icon/job2.svg" alt="image">
                                    </div>
                                    <div class="coundown">
                                        <p>Live Jobs</p>
                                        <div class="d-flex align-items-center gap-2">
                                            <h3 class="odometer">
                                                @jobCount
                                            </h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-sm-6">
                                <div class="counter-single">
                                    <div class="counter-icon">
                                        <img src="~/images/icon/companies.svg" alt="image">
                                    </div>
                                    <div class="coundown">
                                        <p>Companies</p>
                                        <div class="d-flex align-items-center gap-2">
                                            <h3 class="odometer">
                                                @companyCount
                                            </h3>
                                            <span>+</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-sm-6">
                                <div class="counter-single">
                                    <div class="counter-icon">
                                        <img src="~/images/icon/candidates.svg" alt="image">
                                    </div>
                                    <div class="coundown">
                                        <p>Candidates</p>
                                        <div class="d-flex align-items-center gap-2">
                                            <h3 class="odometer">
                                                @candidateCount
                                            </h3>
                                            <span>+</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-sm-6">
                                <div class="counter-single">
                                    <div class="counter-icon">
                                        <img src="~/images/icon/new-jobs.svg" alt="image">
                                    </div>
                                    <div class="coundown">
                                        <p>New Jobs</p>
                                        <div class="d-flex align-items-center gap-2">
                                            <h3 class="odometer">
                                                @newjobCount
                                            </h3>
                                            <span>+</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="job-search-area">
                        <form asp-controller="job" asp-action="Index" method="get"> 
                            <div class="form-inner job-title">
                                <input type="text" name="SearchTerm" placeholder="Job Title">
                            </div>
                            <div class="form-inner category">
                                <select name="CategoryIds" asp-items="@jobCategoryItems" class="select1">
                                    <option value="">All Categories</option>
                                </select>
                            </div>
                            <div class="form-inner">
                                <button type="submit" class="primry-btn-2 "><img src="~/images/icon/search-icon.svg" alt=""> Search</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Hero One end============= -->
@if(jobCategories.Any()){
<!-- ========== Home Four Category Start============= -->
<div class="home4-category-area pt-120 mb-120" id="home4-category">
    <div class="container">
        <div class="row mb-60">
            <div class="col-12 d-flex flex-wrap align-items-end justify-content-md-between justify-content-start gap-3">
                <div class="section-title1">
                    <h2>Jobs <span>Category</span> List</h2>
                    <p>To choose your trending job dream &amp; to make future bright.</p>
                </div>
            </div>
        </div>
        <div class="row row-cols-xxl-5 row-cols-xl-4 row-cols-lg-4 row-cols-md-3 row-cols-sm-2 row-cols-1 g-4 cf justify-content-center">
            @foreach (var jobCategory in jobCategories ?? [])
            {
                <div class="col">
                    <div class="job-category-card2">
                    <div class="job-content-inner">
                        <div class="cart-front">
                            <h5><a href="job-listing1.html">@jobCategory.Name</a></h5>
                            <p>@(jobCategory.JobIds.Count()) Jobs Available</p>
                            <div class="view-btn1">
                                <a href="category.html">View All Jobs</a>
                            </div>
                        </div>
                        <div class="card-back">
                            <div class="category-img">
                                <img src="@jobCategory.ImageUrl" alt="">
                            </div>
                            <div class="category-content">
                                <h5><a href="job-listing1.html">@jobCategory.Name</a></h5>
                                <p>@(jobCategory.JobIds.Count()) Jobs Available</p>
                                <div class="view-btn1">
                                    <a asp-controller="job"
                                        asp-action="index"
                                        asp-route-CategoryIds="@jobCategory.Id">View All <i class="bi bi-arrow-right"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
</div>
<!-- ========== Home Four Category End============= -->
}
@if(jobs.Any()){
<!-- ========== Home1 Featured Start============= -->
<div class="home1-featured-area mb-120">
    <div class="container">
        <div class="row mb-60">
            <div class="col-12 d-flex flex-wrap align-items-end justify-content-md-between justify-content-start gap-3">
                <div class="section-title1">
                    <h2>Latest <span>Featured</span> Jobs</h2>
                    <p>To choose your trending job dream & to make future bright.</p>
                </div>
                <div class="explore-btn">
                    <a asp-controller="job" asp-action="index">Explore More <span><img src="~/images/icon/explore-elliose.svg" alt=""></span></a>
                </div>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var job in jobs ?? [])
            {
                <div class="col-xl-4 col-lg-6">
                    <div class="feature-card">
                    <div class="company-area">
                        <div class="logo">
                            <img src="@job.CompanyLogoUrl" alt="">
                        </div>
                        <div class="company-details">
                            <div class="name-location">
                                <h5><a asp-controller="job" asp-action="details" asp-route-id="@job.DetailsUrl">@job.Title</a></h5>
                                <p>@localizer.GetValue(job.JobType ?? "")</p>
                            </div>
                            <div class="bookmark">
                                <i class="bi bi-bookmark"></i>
                            </div>
                        </div>
                    </div>
                    <div class="job-discription">
                        <ul>
                            <li>
                                <img src="~/images/icon/arrow2.svg" alt="">
                                <p><span class="title">Salary:</span> $@job.MinSalary-$@job.MaxSalary / <span class="time">@localizer.GetValue(job.SalaryTypeDuration ?? "")</span></p>
                            </li>
                            <li>
                                <img src="~/images/icon/arrow2.svg" alt="">
                                <p><span class="title">Vacancy:</span> <span> @job.VacancyCount Person (@localizer.GetValue(job.Gender!))</span></p>
                            </li>
                            <li>
                                <img src="~/images/icon/arrow2.svg" alt="">
                                <p><span class="title">Deadline:</span> <span> @job.ExpirationDate?.Date.ToShortDateString()</span></p>
                            </li>
                        </ul>
                    </div>
                    <div class="job-type-apply">
                        <div class="apply-btn">
                            @if(job.IsApplied==true)
                            {
                                <a asp-controller="candidate" asp-action="appliedJobs"><span><img src="~/images/icon/apply-ellipse.svg" alt=""></span>Applied</a>
                            }
                            else
                            {
                                <a onclick="applyJob(@job.Id, this)"><span><img src="~/images/icon/apply-ellipse.svg" alt=""></span>Apply Now</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
</div>
<!-- ========== Home1 Featured end============= -->
}
<!-- ========== Home1 Work Process Start============= -->
<div class="home1-work-process mb-120">
    <div class="container">
        <div class="row mb-60">
            <div class="col-12 d-flex justify-content-center">
                <div class="section-title1 text-center">
                    <h2>JOBES Working <span>Process</span></h2>
                    <p>To choose your trending job dream & to make future bright.</p>
                </div>
            </div>
        </div>
        <div class="row g-lg-4 gy-5 justify-content-center">
            <div class="col-xl-3 col-lg-4 col-sm-6">
                <div class="single-work-process one text-center">
                    <div class="icon">
                        <img src="~/images/icon/account-create.svg" alt="">
                    </div>
                    <div class="work-content">
                        <h5><a>Account Create</a></h5>
                        <p>To create your account be confident & safely.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-sm-6">
                <div class="single-work-process two text-center">
                    <div class="icon">
                        <img src="~/images/icon/create-resume.svg" alt="">
                    </div>
                    <div class="work-content">
                        <h5><a>Create Resume</a></h5>
                        <p>To create your account be confident & safely.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-sm-6">
                <div class="single-work-process one text-center">
                    <div class="icon">
                        <img src="~/images/icon/job-find.svg" alt="">
                    </div>
                    <div class="work-content">
                        <h5><a>Find Jobs </a></h5>
                        <p>To create your account be confident & safely.</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-lg-4 col-sm-6">
                <div class="single-work-process two text-center">
                    <div class="icon">
                        <img src="~/images/icon/job-apply.svg" alt="">
                    </div>
                    <div class="work-content">
                        <h5><a>Apply Jobs</a></h5>
                        <p>To create your account be confident & safely.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Home1 Work Process end============= -->
@if(addresses.Any()){
<!-- ========== Home1 Location Start============= -->
<div class="home1-location-area mb-120">
    <div class="container">
        <div class="row mb-60">
            <div class="col-12 d-flex flex-wrap align-items-end justify-content-md-between justify-content-start gap-3">
                <div class="section-title1">
                    <h2>Get Dream With <span>Location</span></h2>
                    <p>To choose your trending job dream & to make future bright.</p>
                </div>
                <div class="swiper-btn1 d-flex align-items-center">
                    <div class="left-btn prev-1">
                        <img src="~/images/icon/explore-elliose.svg" alt="">
                    </div>
                    <div class="right-btn next-1">
                        <img src="~/images/icon/explore-elliose.svg" alt="">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="swiper location-slider">
                <div class="swiper-wrapper">
                     @foreach (var addressGroup in addresses ?? [])
                    {
                        <div class="swiper-slide">
                            <div class="location-card">
                                <div class="location-img">
                                    <img class="img-fluid" src="@addressGroup.FirstOrDefault()?.City?.CoverPhotoUrl" alt="">
                                </div>
                                <div class="location-content text-center">
                                    <h5><a asp-controller="company" asp-action="index" asp-route-CityIds="@addressGroup.FirstOrDefault()?.City.Id"><img src="~/images/icon/location.svg" alt="">@addressGroup.FirstOrDefault()?.CityName, @addressGroup.FirstOrDefault()?.CountryName</a></h5>
                                    <p>Companies: <span>@addressGroup.Count()</span></p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Home1 Location end============= -->
}
@if(companies.Any()){
<!-- ========== Home1 Top Recruiters area Start============= -->
<div class="home1-top-recruiters mb-120">
    <div class="container">
        <div class="row mb-60">
            <div class="col-12 d-flex flex-wrap align-items-end justify-content-md-between justify-content-start gap-3">
                <div class="section-title1">
                    <h2>Our Top <span>Recruiters</span></h2>
                    <p>To choose your trending job dream & to make future bright.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="slick-wrapper">
                <div id="slick1">
                     @foreach (var item in companies ?? [])
                    {
                        <div class="slide-item">
                            <div class="recruters-card">
                                <div class="company-area">
                                    <div class="logo">
                                        <img src="@item?.LogoUrl" alt="">
                                    </div>
                                    <div class="name-location">
                                        <h5><a asp-controller="company" asp-action="details" asp-route-id="@item?.DetailsUrl">@item?.Name</a></h5>
                                        <p><img src="~/images/icon/location.svg" alt=""> @item?.MainAddress?.City?.Name, @item?.MainAddress?.City?.Country?.Name</p>
                                        <p><img src="~/images/icon/person-2.svg" alt=""> @item?.CompanySize People</p>
                                    </div>
                                </div>
                                <div class="job-details-vacancies">
                                    <div class="apply-btn">
                                        <a asp-controller="company" asp-action="details" asp-route-id="@item?.DetailsUrl" ><span><img src="~/images/icon/apply-ellipse.svg" alt=""></span>View Details</a>
                                    </div>
                                    <div class="vacancies">
                                        <p>Active Jobs: <span>@item.ActiveJobCount</span></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
             </div>
        </div>
</div>
</div>
}
<br/>
<br/>
<!-- ========== Home1 Top Recruiters area end============= -->
