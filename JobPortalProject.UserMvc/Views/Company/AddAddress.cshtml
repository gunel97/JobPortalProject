@model AddressCreateViewModel

<div class="dashboard-area company-dashboard pt-120 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 mb-50">
                <partial name="_SidebarPartial" model="@Model.SelectedLanguageId" />
            </div>
            <div class="col-lg-12">
                <div class="my-profile-inner ">

                    <div class="form-wrapper">
                        <div class="section-title two">
                            <h5>Add Location</h5>
                            <div class="dash"></div>
                        </div>
                        <form method="post" class="profile-form" enctype="multipart/form-data">
                            <input asp-for="SelectedLanguageId" value="@Model.SelectedLanguageId" type="hidden" />
                            <div id="workingField" class="work-area-row">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-inner mb-25">
                                            <label for="location">City *</label>
                                            <div class="input-area">
                                                <img src="~/images/icon/map-2.svg" alt="">
                                                <select asp-items="Model.CityListItems" asp-for="CityId" class="select1"></select>
                                                <span asp-validation-for="CityId"></span>
                                            </div>
                                        </div>
                                    </div>
                                    @for (int i = 0; i < Model.CompanyTranslationsCount; i++)
                                    {
                                        <input asp-for="AddressTranslationCreateViewModels[i].LanguageId"
                                               value="@Model.AddressTranslationCreateViewModels[i].LanguageId" type="hidden" />

                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="location">Street *</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/map-2.svg" alt="">
                                                    <input asp-for="AddressTranslationCreateViewModels[i].Street" id="location" placeholder="Type Street">
                                                    <span asp-validation-for="AddressTranslationCreateViewModels[i].Street"></span>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="col-md-12">
                                        <div class="form-inner">
                                            <button class="primry-btn-2 lg-btn w-unset" type="submit">Add</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <br />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
