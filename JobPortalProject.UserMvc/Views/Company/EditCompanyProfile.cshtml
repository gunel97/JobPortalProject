@model CompanyUpdateViewModel
@inject StringLocalizerManager localizer;
 <!-- ========== Edit Area end============= -->
<div class="dashboard-area company-dashboard pt-120 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 mb-50">
             <partial name="_SidebarPartial" model="@Model.SelectedUpdateLanguageId" />
            </div>
            <div class="col-lg-12">
                <div class="my-profile-inner ">

                    <div class="form-wrapper">
                        <div class="section-title two">
                            <h5>My Profile</h5>
                            <div class="dash"></div>
                        </div>
                        <form  method="post"  class="profile-form" enctype="multipart/form-data">
                            <input asp-for="Id" value="@Model.Id" type="hidden" />
                            <input asp-for="SelectedUpdateLanguageId" value="@Model.SelectedUpdateLanguageId" type="hidden" />
                            <div class="section-title2">
                                <h5>Company Information:</h5>
                            </div>
                            <div class="row">
                        
                                <div class="col-md-6">
                                    <div class="form-inner mb-25">
                                        <label>Company Type*</label>
                                        <div class="input-area">
                                            <img src="~/images/icon/category-2.svg" alt="">
                                            <select asp-items="Model.CompanyTypeList" asp-for="CompanyTypeId" class="select1"></select>
                                            <span asp-validation-for="CompanyTypeId"></span>
                                        </div>
                                    </div>
                                </div>
                                @if (Model.AddressesOfCompany.Any())
                                {
                                    <div class="col-md-6">
                                        <div class="form-inner mb-25">
                                            <label>Main Address*</label>
                                            <div class="input-area">
                                                <img src="~/images/icon/category-2.svg" alt="">
                                                <select asp-items="Model.AddressesOfCompany" asp-for="MainAddressId" class="select1"></select>
                                                <span asp-validation-for="MainAddressId"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="col-md-6">
                                    <div class="form-inner mb-25">
                                        <label for="company">Company Size*</label>
                                        <div class="input-area">
                                            <img src="~/images/icon/person-2.svg" alt="">
                                            <input asp-for="CompanySize" placeholder="40 Person">
                                        </div>
                                    </div>
                                </div>
                                <div class="phone-email-area">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="info-title">
                                                <h6>Phone & Email & Web</h6>
                                                <div class="dash"></div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="pphonenumber">Primary Number*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/phone-2.svg" alt="">
                                                    <input asp-for="PrimaryPhone" id="pphonenumber" placeholder="+880-17 *** *** **">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="sphonenumber">Secondary Number*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/phone-2.svg" alt="">
                                                    <input asp-for="SecondaryPhone" id="sphonenumber" placeholder="+880-17 *** *** **">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="email">Email*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/email-2.svg" alt="">
                                                    <input asp-for="CompanyEmail" id="email" placeholder="info@example.com">
                                                </div>
                                            </div>
                                        </div>
                                        @for (int i = 0; i < Model.CompanySocialUpdateViewModels.Count; i++)
                                        {
                                            <div class="col-md-6">
                                                <div class="form-inner mb-25">
                                                    <label for="facebook">@Model.CompanySocialUpdateViewModels[i].Title</label>
                                                    <div class="input-area">
                                                        <img src="@Model.CompanySocialUpdateViewModels[i].IconUrl" alt="">
                                                        <input asp-for="CompanySocialUpdateViewModels[i].AddressUrl" id="facebook" placeholder="https://example-facebook.com/">
                                                        <input asp-for="CompanySocialUpdateViewModels[i].Id" value="@Model.CompanySocialUpdateViewModels[i].Id" type="hidden" />
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="section-title2">
                                        <h5>Company Image:</h5>
                                    </div>
                                    <div class="company-images-area mb-50">
                                        <div class="row g-lg-4 gy-5">
                                            <div class="col-lg-6 devaider1 position-relative">
                                                <div class="company-logo-area">
                                                    <h5>Company Logo: </h5>
                                                    <div>
                                                        <div class="drag-area">
                                                            <p>Upload Logo</p>
                                                            <button type="button" class="upload-btn"><i class="bi bi-plus-lg"></i></button>
                                                            <input asp-for="LogoFile" accept="image/*">
                                                        </div>
                                                        <br />
                                                        <div>
                                                            <input name="LogoUrl" value="@Model.LogoUrl" type="hidden" />
                                                            <img src="@Model.LogoUrl" width="100" height="100" />
                                                        </div>
                                                    </div>

                                                    <span>Maximum File Upload: 2 MB</span>
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="company-cover-photo-area">
                                                    <h5>Company Cover Photo: </h5>
                                                    <div class="drag-area" id="dragArea2">
                                                        <p>Upload Photo</p>
                                                        <button type="button" class="upload-btn"><i class="bi bi-plus-lg"></i></button>
                                                        <input asp-for="CoverPhotoFile" accept="image/*">
                                                    </div>
                                                    <br />
                                                    <div class="drag-area" id="dragArea2">
                                                        <input name="CoverPhotoUrl" value="@Model.CoverPhotoUrl" type="hidden" />
                                                        <img src="@Model.CoverPhotoUrl" width="100" height="100" />
                                                    </div>
                                                    <span>Maximum File Upload: 5 MB</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-inner">
                                        <button class="primry-btn-2 lg-btn w-unset"  type="submit">Update Change</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                       
                    </div>
</div>
                <div class="my-profile-inner ">
                    <div class="form-wrapper">
                        <br />
                        <div class="section-title two">
                            <h5>Profile Details</h5>
                            <div class="dash"></div>
                        </div>
                        <form asp-controller="company" asp-action="UpdateCompanyTranslation" class="profile-form" enctype="multipart/form-data">
                            <div class="col-lg-12">
                                <div class="action-btn-group">
                                    <div class="add-row">
                                        <a data-bs-toggle="modal" data-bs-target="#addWorkingFieldModal" class="primry-btn-2 lg-btn w-unset">Add Working Field</a>
                                        <a data-bs-toggle="modal" data-bs-target="#addAddressModal" class="primry-btn-2 lg-btn w-unset">Add Location</a>
                                        <a data-bs-toggle="modal" data-bs-target="#addSocialMediaModal" class="primry-btn-2 lg-btn w-unset">Add Social Media Address</a>
                                    </div>
                                </div>
                                <br />
                                <div class="action-btn-group">
                                    <ul>
                                        @foreach (var translation in Model.CompanyTranslations ?? [])
                                        {
                                            <li>
                                                <div class="add-row">
                                                    <button type="button" onclick="updateCompanyTranslation(@translation.LanguageId)">
                                                        <span>
                                                            <img src="~/images/icon/edit2.svg" alt="">
                                                            <span><img src="@translation.LanguageIcon" alt="">@localizer.GetValue("editProfile")</span>
                                                        </span>
                                                    </button>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <div id="companyTranslation" class="col-lg-12">
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Edit Area end============= -->

<!-- ========== Add social media field modal============= -->
<div class="modal fade" id="addSocialMediaModal" tabindex="-1" aria-labelledby="addSocialMediaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addSocialMediaModalLabel">Add Social Media</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" enctype="multipart/form-data"
                  asp-action="AddCompanySocialMedia" asp-controller="Company">
                <div class="modal-body">
                    <input type="hidden" name="CompanyId" value="@Model.Id" />
                    <div class="work-area-row">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label for="location">Socia Media *</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/company-2" alt="">
                                        <select name="SocialMediaId" asp-items="@Model.SocialMediasList" class="select1"></select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label for="mainAddress">Address Url*</label>
                                    <div class="input-area">
                                        <input name="AddressUrl" placeholder="Url..." class="form-control">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="primry-btn-2 lg-btn w-unset">Add Social Media Address</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ========== Add social media field modal end============= -->

<!-- ========== Add address field modal============= -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-labelledby="addAddressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addAddressModalLabel">Add Address</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" enctype="multipart/form-data"
                asp-action="AddAddress" asp-controller="Company">
                <div class="modal-body">
                    <input type="hidden" name="CompanyId" value="@Model.Id" />
                    <input name="SelectedLanguageId" value="@Model.SelectedUpdateLanguageId" type="hidden" />
                    <div class="work-area-row">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label for="location">City *</label>
                                    <div class="input-area">
                                        <img src="~/images/icon/map-2.svg" alt="">
                                        <select name="CityId" asp-items="@Model.CitiesList" class="select1"></select>
                                    </div>
                                </div>
                            </div>
                            
                    @if (Model.CompanyTranslations != null && Model.CompanyTranslations.Any())
                    {
                        @for (int i = 0; i < Model.CompanyTranslations.Count; i++)
                        {
                            <input name="AddressTranslationCreateViewModels[@i].LanguageId" value="@Model.CompanyTranslations[i].LanguageId" type="hidden" />
                         <div class="form-inner mb-25">
                                <div class="col-lg-12 mb-3">
                                    <h6><img src="@Model.CompanyTranslations[i].LanguageIcon" alt="" /> Translation:</h6>
                                </div>
                            <div class="col-md-6">
                                <div class="input-area">
                                    <input name="AddressTranslationCreateViewModels[@i].Street" placeholder="Street Name" class="form-control">
                                </div>
                            </div>
                         </div>
                        }
                    }
                    <div class="col-md-6">
                                <div class="form-inner mb-25">
                                    <label for="mainAddress">Is Main Address *</label>
                                    <div class="input-area">
                                        <input name="IsMainAddress" value="true" type="checkbox" id="mainAddress">
                                    </div>
                                </div>
                            </div>
                </div>
                </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="primry-btn-2 lg-btn w-unset">Add Address</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ========== Add address field modal end============= -->

<!-- ========== Add working field modal============= -->
<div class="modal fade" id="addWorkingFieldModal" tabindex="-1" aria-labelledby="addWorkingFieldModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addWorkingFieldModalLabel">Add Work Area</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" enctype="multipart/form-data"
                asp-action="AddWorkingField" asp-controller="Company">
                <div class="modal-body">
                    <input type="hidden" name="CompanyId" value="@Model.Id" />

                    <div class="col-md-12">
                        <div class="form-inner mb-25">
                            <label>Add Icon*</label>
                            <div class="input-area">
                                <img src="~/images/icon/company-2.svg" alt="">
                                <input type="file" name="IconFile" accept="image/*">
                            </div>
                        </div>
                    </div>
                    @if (Model.CompanyTranslations != null && Model.CompanyTranslations.Any())
                    {


                        @for (int i = 0; i < Model.CompanyTranslations.Count; i++)
                        {
                            <input name="WorkingFieldTranslationCreateViewModels[@i].SelectedUpdateLanguageId" value="@Model.SelectedUpdateLanguageId" type="hidden" />
                            <div class="form-inner mb-25">
                                <div class="col-lg-12 mb-3">
                                    <h6><img src="@Model.CompanyTranslations[i].LanguageIcon" alt="" /> Translation:</h6>
                                </div>
                                <div class="col-md-6">

                                    <input name="WorkingFieldTranslationCreateViewModels[@i].LanguageId" value="@Model.CompanyTranslations[i].LanguageId" type="hidden" />
                                    <div class="input-area">
                                        <input name="WorkingFieldTranslationCreateViewModels[@i].Name" placeholder="Work Area Name" class="form-control">
                                    </div>
                                    <div class="input-area">
                                        <input name="WorkingFieldTranslationCreateViewModels[@i].Description" placeholder="Work Area Description" class="form-control">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="primry-btn-2 lg-btn w-unset">Add Work Area</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- ========== Add working field modal end============= -->



@if (TempData["CloseModal"] != null)
{
    <script>
        // Close the modal on page load
        document.addEventListener('DOMContentLoaded', function() {
            var modal = bootstrap.Modal.getInstance(document.getElementById('addResponsibilityModal'));
            if (modal) {
                modal.hide();
            }

            // Optional: Show success message
            @if (TempData["Success"] != null)
            {
                        <text>
                        alert('@TempData["Success"]');
                        </text>
            }
        });
    </script>
}
