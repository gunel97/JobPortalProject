@model CompanyRegisterViewModel; 

<!-- ========== Login Area end============= -->
<div class="register-area pt-120 mb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="form-wrapper">
                    <div class="form-title">
                        <h3>Register Account</h3>
                        <span></span>
                    </div>
                    <div class="register-tab">
                        <nav>
                            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                <a class="nav-link" id="nav-home-tab" asp-controller="account" asp-action="registerCandidate">Candidate</a>
                                <button class="nav-link active" id="nav-profile-tab" type="button">Company</button>
                            </div>
                        </nav>
                        <div class="tab-content" id="nav-tabContent">
                             <div class="tab-pane fade show active" id="nav-profile" role="tabpanel" aria-labelledby="nav-profile-tab">
                                <form method="post">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="firstname">First Name*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/user-2.svg" alt="">
                                                    <input asp-for="FirstName" id="firstname" placeholder="Mr. Robert">
                                                    <span asp-validation-for="FirstName"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="lastname">Last Name*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/user-2.svg" alt="">
                                                    <input asp-for="LastName" id="lastname" placeholder="Jonson">
                                                    <span asp-validation-for="LastName"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="username">User Name*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/user-2.svg" alt="">
                                                    <input asp-for="Username" id="username1"  placeholder="robertjonson">
                                                    <span asp-validation-for="Username"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="email">Email*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/email-2.svg" alt="">
                                                    <input asp-for="Email" id="email1" placeholder="info@example.com">
                                                    <span asp-validation-for="Email"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="companyname">Company Name*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/company-2.svg" alt="">
                                                    <input asp-for="CompanyName" id="companyname" placeholder="Mr. Robert">
                                                    <span asp-validation-for="CompanyName"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label>Company Type*</label>
                                                <div class="input-area">
                                                    <img src="~/images/icon/category-2.svg" alt="">
                                                    <select asp-items="@Model.CompanyTypesList" asp-for="CompanyTypeId"></select>
                                                    <span asp-validation-for="CompanyTypeId"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner mb-25">
                                                <label for="password">Password*</label>
                                                <input asp-for="Password" id="password3" placeholder="Password" />
                                                <span asp-validation-for="Password"></span>
                                                <i class="bi bi-eye-slash" id="togglePassword3"></i>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-inner">
                                                <label for="password4">Confirm Password*</label>
                                                <input asp-for="ConfirmPassword" id="password4" placeholder="Confirm Password" />
                                                <i class="bi bi-eye-slash" id="togglePassword4"></i>
                                            </div>
                                        </div>
                                        <div asp-validation-summary="ModelOnly"></div>
                                        <div class="col-md-12">
                                            <div class="form-inner">
                                                <button class="primry-btn-2" type="submit">Sign Up</button>
                                            </div>
                                        </div>
                                        <h6>Already have an account? <a asp-controller="account" asp-action="login"> Login</a> Here</h6>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Login Area end============= -->