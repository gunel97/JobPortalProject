@{
    PagedJobListingViewModel model = Model;
    var filter = model.Filter;
    var jobs = model.Jobs;
    var genders = model.Genders;
    var jobCategories = model.JobCategories;
    var jobTypes = model.JobTypes;
}  
@inject StringLocalizerManager localizer;

 <!-- ========== Inner Banner Start============= -->
<div class="inner-banner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="banner-content text-center">
                    <h1>Job Listing</h1>
                    <span></span>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="home" asp-action="index">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Job Listing  </li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ========== Inner Banner end============= -->
<!-- ========== Job Listing Start============= -->
<div class="job-listing-area pt-120 mb-120">
    <div class="container">
         <form asp-action="Index" method="get" id="filterForm">
        <div class="row g-lg-4 gy-5">
            <div class="col-lg-4 order-lg-1 order-2">
                <div class="job-sidebar">
                        <div class="job-widget mb-20">
                            <div class="check-box-item">
                                <h5 class="job-widget-title">Search</h5>
                                <div class="form-inner">
                                    <input type="text"
                                           name="SearchTerm"
                                           value="@filter.SearchTerm"
                                           placeholder="Search job name..."
                                           class="form-control">
                                </div>
                            </div>
                        </div>
                    <div class="job-widget style-1 mb-20">
                        <div class="check-box-item">
                            <h5 class="job-widget-title">Job Category</h5>
                            <div class="checkbox-container">
                                <ul>
                                    @foreach (var category in jobCategories)
                                    {
                                        <li>
                                            <label class="containerss">
                                                <input type="checkbox"
                                                    name="CategoryIds"
                                                value="@category.Id"
                                                @(filter.CategoryIds.Contains(category.Id) ? "checked": "")
                                                       onchange="document.getElementById('Index').value=0;  document.getElementById('filterForm').submit();">
                                                <span class="checkmark"></span>
                                                <span class="text">@category.Name</span>
                                                <span class="qty">(@category.JobIds.Count())</span>
                                            </label>
                                        </li>
                                    }
                                </ul>

                            </div>
                        </div>
                    </div>
                    <div class="job-widget mb-20">
                        <div class="check-box-item">
                            <h5 class="job-widget-title">Type of Employments</h5>
                            <div class="checkbox-container">
                                <ul>
                                    @foreach (var type in jobTypes)
                                    {
                                           var count =  model.JobTypeCounts.ContainsKey(int.Parse(type.Value))
                                            ? model.JobTypeCounts[int.Parse(type.Value)]
                                            : 0;
                                            if(count!=0){
                                        <li>
                                            <label class="containerss">
                                                    <input type="checkbox"
                                                    name="JobTypeIds"
                                                    value="@type.Value"
                                                    @(filter.JobTypeIds.Contains(int.Parse(type.Value)) ? "checked" : "")
                                                    onchange="document.getElementById('Index').value = 0; document.getElementById('filterForm').submit();">
                                                    <span class="checkmark"></span>
                                                    <span class="text">@localizer.GetValue(@type.Text)</span>
                                                <span class="qty">(@count)</span>
                                            </label>
                                        </li>
                                        }
                                    }
                                </ul>

                            </div>
                        </div>
                    </div>
                    <div class="job-widget mb-20">
                        <div class="check-box-item">
                            <h5 class="job-widget-title">Gender</h5>
                            <div class="checkbox-container">
                                <ul>
                                    @foreach (var gender in genders)
                                    {
                                            var count = model.GenderCounts.ContainsKey(int.Parse(gender.Value))
                                            ? model.GenderCounts[int.Parse(gender.Value)]
                                            : 0;
                                            if(count!=0){
                                        <li>
                                            <label class="containerss">
                                            <input type="checkbox"
                                                    name="GenderIds"
                                                    value="@gender.Value"
                                                    @(filter.GenderIds.Contains(int.Parse(gender.Value)) ? "checked" : "")
                                                    onchange="document.getElementById('Index').value = 0; document.getElementById('filterForm').submit();">
                                                <span class="checkmark"></span>
                                                <span class="text">@localizer.GetValue(gender.Text)</span>
                                                <span class="qty">(@count)</span>
                                            </label>
                                        </li>
                                        }
                                    }
                                </ul>

                            </div>
                        </div>
                    </div>
                    <div class="job-widget mb-20">
                        <div class="check-box-item">
                            <h5 class="job-widget-title mb-15">Salary Range</h5>
                            <div class="range-wrap">
                                <div class="slider-labels">
                                    <div class="caption">
                                        <span id="slider-range-value1">@(filter.MinSalary ?? Model.MinSalary ?? "0") </span>$
                                    </div>
                                    -
                                    <div class="text-right caption">
                                        <span id="slider-range-value2">@(filter.MaxSalary ?? Model.MaxSalary ?? "100000")</span>$
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12">
                                            <input type="hidden" name="MinSalary" id="MinSalary" value="@filter.MinSalary">
                                            <input type="hidden" name="MaxSalary" id="MaxSalary" value="@filter.MaxSalary">                                       
                                    </div>
                                </div>
                                    <div class="row mb-3">
                                        <div class="col-sm-6">
                                            <label class="form-label small">Min: <span id="minDisplay">@(filter.MinSalary ?? Model.MinSalary)</span>$</label>
                                            <input type="range" class="form-range" id="minSlider" min="@Model.MinSalary" max="@Model.MaxSalary" step="@((Model.MaxSalary-Model.MinSalary)/100)" value="@(filter.MinSalary ?? Model.MinSalary)">
                                        </div>
                                        <div class="col-sm-6">
                                            <label class="form-label small">Max: <span id="maxDisplay">@(filter.MaxSalary ?? Model.MaxSalary)</span>$</label>
                                            <input type="range" class="form-range" id="maxSlider" min="@Model.MinSalary" max="@Model.MaxSalary" step="@((Model.MaxSalary - Model.MinSalary) / 100)" value="@(filter.MaxSalary ?? Model.MaxSalary)">
                                        </div>
                                    </div>

                            </div>
                        </div>
                    </div>
                    <div class="job-widget-btn">
                        <a class="primry-btn-2 lg-btn text-center" asp-action="Index">Clear filter</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-8 order-lg-2 order-1">
                <div class="job-listing-wrrap">
                    <div class="row g-4 mb-25">
                        <div class="col-lg-6 d-flex align-items-center">
                            @if(jobs.Count==0){
                            <p class="show-item">No jobs found.</p>
                            }
                            @if(jobs.Count>0){
                            <p class="show-item">Showing results @((jobs.Index*jobs.Size)+1) - @Math.Min((jobs.Index+1)*jobs.Size, jobs.Count) from @jobs.Count jobs</p>
                            }
                        </div>
                        <div class="col-lg-6 d-flex align-items-center justify-content-lg-end">
                            <div class="grid-select-area">
                                <div class="select-area">
                                    <select class="select1" name="SortBy" onchange="document.getElementById('Index').value = 0; document.getElementById('filterForm').submit();">
                                        <option value="PostedDate"
                                                selected="@(filter.SortBy == "PostedDate")">Sort By (Default)</option>
                                        <option value="Title_asc"
                                                selected="@(filter.SortBy == "Title_asc")">Title (A-Z)</option>
                                        <option value="Title_desc"
                                                selected="@(filter.SortBy == "Title_desc")">Title (Z-A)</option>
                                        <option value="Salary_asc"
                                                selected="@(filter.SortBy == "Salary_asc")">Salary (Low to High)</option>
                                        <option value="Salary_desc"
                                                selected="@(filter.SortBy == "Salary_desc")">Salary (High to Low)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row ">
                        @if(jobs.Items.Any())
                        {
                            @foreach (var job in jobs.Items)
                            {
                                @if(!job.Expired){
                               <partial name="_JobListingCardPartial" model="@job" />
                                }
                            }
                        }
                        @{
                            var routeData = new Dictionary<string, string>
                                                {
                                                { "size", jobs.Size.ToString() },
                                                { "MinSalary", filter.MinSalary?.ToString() ?? "" },
                                                { "MaxSalary", filter.MaxSalary?.ToString() ?? "" },
                                                { "SortBy", filter.SortBy ?? "" },
                                                { "SortOrder", filter.SortOrder ?? "" }
                                                };

                            // Add multi-select arrays
                            for (int i = 0; i < filter.CategoryIds.Count; i++)
                            {
                                routeData[$"CategoryIds[{i}]"] = filter.CategoryIds[i].ToString();
                            }
                                for (int i = 0; i < filter.JobTypeIds.Count; i++)
                                {
                                    routeData[$"JobTypeIds[{i}]"] = filter.JobTypeIds[i].ToString();
                                }
                                for (int i = 0; i < filter.GenderIds.Count; i++)
                                {
                                    routeData[$"GenderIds[{i}]"] = filter.GenderIds[i].ToString();
                                }

                            ViewData["RouteData"] = routeData;
                        }

                        <div class="col-lg-12 d-flex justify-content-center">
                            <partial name="_PaginationPartial" model="@jobs" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
            <input type="hidden" name="Index" id="Index" value="@filter.Index" />
            <input type="hidden" name="Size" value="@filter.Size" />
            <input type="hidden" name="SortOrder" value="@filter.SortOrder" />
        </form>
    </div>
</div>
<!-- ========== Job Listing e nd============= -->

    <script>
        console.log("test");
        // Vanilla JavaScript Salary Range Sliders
        const minSlider = document.getElementById('minSlider');
        const maxSlider = document.getElementById('maxSlider');
        const minDisplay = document.getElementById('minDisplay');
        const maxDisplay = document.getElementById('maxDisplay');
        const minInput = document.getElementById('MinSalary');
        const maxInput = document.getElementById('MaxSalary');
        const sliderValue1 = document.getElementById('slider-range-value1');
        const sliderValue2 = document.getElementById('slider-range-value2');
        const filterForm = document.getElementById('filterForm');

        // Update displays when sliders move
        if (minSlider && maxSlider) {
            minSlider.addEventListener('input', function() {
                let minVal = parseInt(this.value);
                let maxVal = parseInt(maxSlider.value);

                // Ensure min doesn't exceed max
                if (minVal > maxVal) {
                    minVal = maxVal;
                    this.value = minVal;
                }

                minDisplay.textContent = minVal;
                sliderValue1.textContent = minVal;
                minInput.value = minVal;
            });

            maxSlider.addEventListener('input', function() {
                let maxVal = parseInt(this.value);
                let minVal = parseInt(minSlider.value);

                // Ensure max doesn't go below min
                if (maxVal < minVal) {
                    maxVal = minVal;
                    this.value = maxVal;
                }

                maxDisplay.textContent = maxVal;
                sliderValue2.textContent = maxVal;
                maxInput.value = maxVal;
            });

            // Submit form when user releases slider
            minSlider.addEventListener('change', function() {
                document.getElementById('Index').value = 0;
                filterForm.submit();
            });

            maxSlider.addEventListener('change', function() {
                document.getElementById('Index').value = 0;
                filterForm.submit();
            });
        }

        // Preset salary range function
        function setSalaryRange(min, max) {
            if (minSlider && maxSlider) {
                minSlider.value = min;
                maxSlider.value = max;
                minDisplay.textContent = min;
                maxDisplay.textContent = max;
            }
            minInput.value = min;
            maxInput.value = max;
            sliderValue1.textContent = min;
            sliderValue2.textContent = max;
            document.getElementById('Index').value = 0;
            filterForm.submit();
        }
    </script>
