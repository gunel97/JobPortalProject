@model WorkingFieldCreateViewModel

<form @* asp-controller="Company" asp-action="AddWorkingField" asp-route-id="@Model.SelectedUpdateLanguageId" *@ method="post" @* class="profile-form"  *@ enctype="multipart/form-data">
    <input asp-for="SelectedUpdateLanguageId" value="@Model.SelectedUpdateLanguageId" type="hidden" />
<div id="workingField" class="work-area-row">
    <div class="row">
        <div class="col-md-6">
            <div class="form-inner mb-25">
                <label for="working-field">Working Field *</label>
                <div class="input-area">
                    <img src="~/images/icon/company-2.svg" alt="">
                    <input asp-for="WorkingFieldTranslationCreateViewModel.Name" id="working-field" placeholder="Frontend Developer" />
                    <span asp-validation-for="WorkingFieldTranslationCreateViewModel.Name"></span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-inner mb-25">
                <label>Add Icon*</label>
                <div class="input-area">
                    <img src="~/images/icon/company-2.svg" alt="">
                    <input asp-for="IconFile" accept="image/*">
                    <span asp-validation-for="IconFile"></span>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-inner mb-40">
                <label for="description">Short Description*</label>
                <input asp-for="WorkingFieldTranslationCreateViewModel.Description" id="description" placeholder="Details*" />
                <span asp-validation-for="WorkingFieldTranslationCreateViewModel.Description"></span>
            </div>
@*                         <button type="submit" >Save Work Area</button> *@
<button asp-controller="company" asp-action="addWorkingField" type="submit">Test</button>
                    
        </div>
    </div>
</div>
</form>